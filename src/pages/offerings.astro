---
import "@/styles/badge/badge.css";
import "@/styles/tabs.css";
import Layout from '../layouts/Layout.astro';
import { tabs } from "../data/offeringTabs";
import Tabs from '../components/ui/Tabs.astro';

// 👉 đọc query ?tab=
const url = new URL(Astro.request.url);
let slug = url.searchParams.get('tab');
const valid = tabs.some(t => t.slug === slug);

// 👉 nếu không có → redirect sang tab đầu
if (!slug) {
  return Astro.redirect(tabs[0].slug);
}
// 👉 fallback nếu slug sai
if (!valid) {
  return Astro.redirect(tabs[0].slug);
}

const title = 'Offering';
const description = 'Cúng dường';
---

<Layout schemaType="Article" title={title} description={description}>
  <div class="badge-page">

    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <h1 class="page-description">{description}</h1>
      <hr class="page-rule" />
    </header>

    <Tabs
        tabs={tabs}
        currentSlug={slug}
        client:load
    />

  </div>
</Layout>
