---
import WikiLayout from "@/layouts/grid-items/WikiLayout.astro";
import { records, getRecord } from "@/data/koan-network/records.ts";

export function getStaticPaths() {
  return records.map((r) => ({ params: { record: r.slug } }));
}

const { record: recordSlug } = Astro.params;
const record = getRecord(recordSlug!);
---

<WikiLayout title={record.title} currentSlug={record.slug} recordSlug={recordSlug} videoIds={{ videoIds: record.videoIds } || {}}>
  <h1>{record.title}</h1>
  <p class="subtitle">{`✒️ ${record.author}`} {record.translator && ` 📝 ${record.translator}`} {record.publisher && `📰 ${record.publisher}`}</p>

  {record.parts?.map((part) => (
    <section>
      <h2>{part.title}</h2>
      <ul>
        {part.koans?.map((k) => (
          <li>
            <a href={`/koans/${record.slug}/${k.slug}`}>
              <span class="num">{k.number}</span>
              <span class="title">{k.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</WikiLayout>

<style>
  h1 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .subtitle {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    margin-bottom: 2.5rem;
  }

  section {
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  ul {
    list-style: none;
  }

  li a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    transition: color 0.1s;
  }

  li a:hover {
    color: var(--accent);
  }

  .num {
    font-size: 0.75rem;
    color: var(--text-muted);
    min-width: 1.5rem;
  }

  .title {
    flex: 1;
  }
</style>
