---
import "@/styles/badge/badge.css";
import Layout from '../layouts/Layout.astro';
import PaymentQR from "@/components/ui/PaymentQR.astro";
import { pagodaList } from "@/data/pagodaData.ts";

const title = 'Cúng dường';
const description = 'Cúng dường';
const pagodaUrl = '/pagodas/thien-tu-Quy-Son';
---

<Layout
    schemaType="Article"
    title={title}
    description={description}
>

  <div class="badge-page">
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <h1 class="page-description">{description}</h1>
      <hr class="page-rule" />
    </header>

    <div class="content-section">
      <PaymentQR
          facebookPostUrl={pagodaList[0]?.facebookPostUrl}
          placeName={pagodaList[0].placeName}
          eventTitle={pagodaList[0].eventTitle}
          bankAccountSrc={pagodaList[0]?.bankAccountSrc}
          bankQrSrc={pagodaList[0]?.bankQrSrc}
          bankNumber={pagodaList[0].bankNumber}
          bankName={pagodaList[0].bankName}
          bankHost={pagodaList[0].bankHost}
          bankHostRole={pagodaList[0].bankHostRole}
          announcement1={pagodaList[0]?.announcement1}
          announcement2={pagodaList[0]?.announcement2}
          googleMap={pagodaList[0]?.googleMap}
          placeAddress={pagodaList[0].placeAddress}
          extraImage={pagodaList[0].extraImage}
      />
    </div>


    <iframe class="wordpress-frame" style="width: 100%; height: 100vh" src={pagodaUrl} title={title}></iframe>
  </div>

</Layout>
