---
import "@/styles/badge/badge.css";
import Layout from '../layouts/Layout.astro';
import PaymentQR from "../components/PaymentQR.astro";

const title = 'Offering';
const description = 'Cúng dường';
const pagodaUrl = '/pagodas/thien-tu-Quy-Son';


---

<Layout
    schemaType="Article"
    title={title}
    description={description}
>

  <div class="badge-page">
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <h1 class="page-description">{description}</h1>
      <hr class="page-rule" />
    </header>

    <div class="content-section">
      <PaymentQR
        facebookPostUrl="https://www.facebook.com/thanhphuong.nhamay.3/posts/pfbid023csyQRmD2Z33pdFXwVQ7GsZY9pupHWGA8c12s8jEAdXjN4NJDDNnX9zGQHvyQ95al"
      />
    </div>

<div class="content-section">
      <PaymentQR />
    </div>

<iframe class="wordpress-frame" style="width: 100%; height: 100vh" src={pagodaUrl} title={title}></iframe>
  </div>
  
</Layout>
