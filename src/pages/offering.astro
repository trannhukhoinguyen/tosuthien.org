---
import "@/styles/badge/badge.css";
import Layout from '../layouts/Layout.astro';
import PaymentQR from "../components/ui/PaymentQR.astro";
import { tabs } from "../data/offeringTabs";

const title = 'Offering';
const description = 'Cúng dường';
const pagodaUrl = '/pagodas/thien-tu-Quy-Son';


---

<Layout
    schemaType="Article"
    title={title}
    description={description}
>

  <div class="badge-page">
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <h1 class="page-description">{description}</h1>
      <hr class="page-rule" />
    </header>

    <div class="content-section">
      <PaymentQR
          facebookPostUrl={tabs[0].facebookPostUrl}
          placeName={tabs[0].placeName}
          eventTitle={tabs[0].eventTitle}
          bankAccountSrc={tabs[0].bankAccountSrc}
          bankQrSrc={tabs[0].bankQrSrc}
          bankNumber={tabs[0].bankNumber}
          bankName={tabs[0].bankName}
          bankHost={tabs[0].bankHost}
          bankHostRole={tabs[0].bankHostRole}
          announcement1={tabs[0].announcement1}
          announcement2={tabs[0].announcement2}
          googleMap={tabs[0].googleMap}
          placeAddress={tabs[0].placeAddress}
          extraImage={tabs[0].extraImage}
      />
    </div>


<iframe class="wordpress-frame" style="width: 100%; height: 100vh" src={pagodaUrl} title={title}></iframe>
  </div>

</Layout>
