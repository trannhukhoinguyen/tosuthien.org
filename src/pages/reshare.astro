---
import "@/styles/badge/badge.css";
import Layout from '@/layouts/Layout.astro';

const title = 'Reshare';
const description = 'Tặng đồ để Tái chế';


---

<Layout
    schemaType="Article"
    title={title}
    description={description}
>
  <iframe
    src="https://tram.reshare.vn/"
    width="100%"
    height="600px"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade">
  </iframe>
</Layout>
