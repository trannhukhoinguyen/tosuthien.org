---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/gallery/Layout.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";
import Breadcrumb from "@/components/gallery/Breadcrumb.astro";
import { config } from "@/config.ts";
import { cleanSlug, toKebabCase } from "@/utils/helper.ts";

export async function getStaticPaths() {
  if (!config.showGalleries) return [];

  const galleries = await getCollection("galleries", ({ data }) => !data.draft);
  return galleries.map(gallery => ({
    params: {
      gallery: gallery.id
        .replace(/\/index\.(md|mdx)$/, "")
        .replace(/\.(md|mdx)$/, ""),
    },
    props: { entry: gallery },
  }));
}

const { entry } = Astro.props;
const { gallery: slug } = Astro.params;
const { title, description, cover, tags } = entry.data;

// Load all gallery images at build-time with a static glob
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/galleries/**/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

type GalleryImage = { src: ImageMetadata; alt: string; filename: string };

function filenameToAlt(filename: string): string {
  return (
    filename
      .replace(/\.[^.]+$/, "") // remove extension
      .replace(/^\d+[-_]?/, "") // remove initial number
      .replace(/[-_]/g, " ") // dashes/underscores → spaces
      .replace(/\b\w/g, c => c.toUpperCase()) // capitalize
      .trim() || title
  );
}

function slugifyStr(str: string): string {
  const hasNonLatin = (str: string): boolean => /[^\x00-\x7F]/.test(str);
  if (hasNonLatin(str)) {
    // Preserve non-Latin characters (e.g., Burmese, Chinese, etc.)
    return toKebabCase(str);
  }
  // Handle Latin strings with better number/acronym handling
  return cleanSlug(str);
}

const images: GalleryImage[] = Object.entries(allImages)
  .filter(
    ([path]) =>
      path.startsWith(`/src/content/galleries/${slug}/`) && !path.includes("index")
  )
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split("/").pop() ?? "";
    return { src: mod.default, alt: filenameToAlt(filename), filename };
  });

// If the frontmatter has coverImage, include it at the beginning if it is not already in the list
const hasCoverInFolder = cover
  ? images.some(img => img.src.src === cover.src)
  : false;

const coverImageSrc = cover
  ? new URL(cover.src, Astro.url.origin).href
  : images.length > 0
    ? new URL(images[0].src.src, Astro.url.origin).href
    : undefined;

// Build Schema.org ImageGallery Structured Data
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: description,
  url: new URL(Astro.url.pathname, Astro.url.origin).toString(),
  ...(coverImageSrc && { image: coverImageSrc }),
  creator: {
    "@type": "Person",
    name: config.author,
    // ...(config.profile && { url: config.profile }),
  },
  numberOfItems: images.length,
};
---

<Layout
  title={`${title} | Galleries | ${config.title}`}
  description={description}
  structuredData={gallerySchema}
>
  {config.showBackButton && <Breadcrumb withBackButton />

  <main id="main-content" class="gallery-main app-layout">
    <!-- Gallery header -->
    <header class="gallery-header">
      <div class="gallery-header-inner">
        <div class="gallery-header-info">
          <div class="gallery-meta">
            <IconGallery class="gallery-meta-icon" />
            <span class="gallery-meta-text">
              Collection // {images.length} {images.length === 1 ? "photo" : "photos"}
            </span>
          </div>

          <h1
            class="gallery-title"
            style={{ viewTransitionName: slugifyStr(String(title).replaceAll(".", "-")) }}
          >
            {title}
          </h1>

          {description && (
            <p class="gallery-description">{description}</p>
          )}
        </div>

        <div class="gallery-header-actions">
          <!-- Additional actions / tags can go here -->
        </div>
      </div>
    </header>

    <!-- Large cover (if defined in frontmatter and not in the folder) -->
    {
      cover && !hasCoverInFolder && (
        <div class="gallery-cover">
          <Image
            src={cover}
            alt={title}
            class="gallery-cover-img"
            loading="eager"
            widths={[800, 1200, 1600]}
            sizes="(max-width: 1200px) 100vw, 1200px"
          />
        </div>
      )
    }

    <!-- Image grid -->
    {
      images.length > 0 ? (
        <ul
          class="gallery-grid"
          id="gallery-grid"
          role="list"
          aria-label={`Images of ${title}`}
        >
          {images.map((img, idx) => (
            <li>
              <button
                class="gallery-item"
                data-index={idx}
                aria-label={`View image: ${img.alt}`}
                type="button"
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  class="gallery-img"
                  loading={idx < 6 ? "eager" : "lazy"}
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                />
                <div class="gallery-item-overlay">
                  <span class="gallery-item-alt">{img.alt}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="gallery-empty">
          This gallery has no images yet.
        </p>
      )
    }
  </main>
</Layout>

<!-- Lightbox dialog -->
<dialog id="lightbox" class="lightbox" aria-label="Image viewer" aria-modal="true">
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span id="lightbox-counter" class="lightbox-counter"></span>
      <button class="lightbox-btn" id="lightbox-close" aria-label="Close" title="Close (Esc)" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="lightbox-main">
      <button class="lightbox-btn lightbox-nav" id="lightbox-prev" aria-label="Previous" title="Previous (Left Arrow)" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="lightbox-figure">
        <img id="lightbox-img" src="" alt="" class="lightbox-image" />
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>

      <button class="lightbox-btn lightbox-nav" id="lightbox-next" aria-label="Next" title="Next (Right Arrow)" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  // Build image array from DOM
  function initGallery() {
    const grid = document.getElementById("gallery-grid");
    const lightbox = document.getElementById(
      "lightbox"
    ) as HTMLDialogElement | null;
    if (!grid || !lightbox) return;

    // From here TypeScript does not carry narrowing to closures; we use the local variable
    const lb = lightbox;

    const items = Array.from(
      grid.querySelectorAll<HTMLButtonElement>(".gallery-item")
    );
    const lightboxImg = document.getElementById(
      "lightbox-img"
    ) as HTMLImageElement;
    const lightboxCaption = document.getElementById(
      "lightbox-caption"
    ) as HTMLElement;
    const lightboxCounter = document.getElementById(
      "lightbox-counter"
    ) as HTMLElement;
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");

    let current = 0;

    function open(idx: number) {
      current = Math.max(0, Math.min(idx, items.length - 1));
      const btn = items[current];
      const img = btn.querySelector("img");
      if (!img) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = img.alt;
      lightboxCounter.textContent = `${current + 1} / ${items.length}`;

      if (prevBtn) prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
      if (nextBtn) nextBtn.style.visibility = current === items.length - 1 ? "hidden" : "visible";

      lb.showModal();
      document.body.style.overflow = "hidden";
    }

    function close() {
      lb.close();
      document.body.style.overflow = "";
    }

    items.forEach((btn, idx) => {
      btn.addEventListener("click", () => open(idx));
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => open(current - 1));
    nextBtn?.addEventListener("click", () => open(current + 1));

    lightbox.addEventListener("click", e => {
      const target = e.target as HTMLElement;
      // Close if click is outside the image, buttons and text
      if (!target.closest("img, button, .lightbox-caption, .lightbox-counter")) {
        close();
      }
    });

    document.addEventListener("keydown", e => {
      if (!lb.open) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") open(current - 1);
      if (e.key === "ArrowRight") open(current + 1);
    });
  }

  // Initialize on first load and SPA navigations (View Transitions)
  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>

<style>
  /* ── Layout & Main ── */
  .gallery-main {
    position: relative;
    padding-bottom: 4rem;
  }

  /* ── Header ── */
  .gallery-header {
    margin-bottom: 3.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 10%, transparent);
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .gallery-header {
      padding-bottom: 3.5rem;
    }
  }

  .gallery-header-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .gallery-header-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .gallery-header-info {
    max-width: 48rem;
  }

  .gallery-meta {
    margin-bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .gallery-meta-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .gallery-meta-text {
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .gallery-title {
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--gallery-foreground);
  }

  @media (min-width: 640px) {
    .gallery-title {
      font-size: 3rem;
      line-height: 1;
    }
  }

  @media (min-width: 1280px) {
    .gallery-title {
      font-size: 3.75rem;
      line-height: 1;
    }
  }

  .gallery-description {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.625;
    color: color-mix(in srgb, var(--gallery-foreground) 60%, transparent);
  }

  @media (min-width: 640px) {
    .gallery-description {
      font-size: 1.25rem;
    }
  }

  .gallery-header-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .gallery-header-actions {
      width: auto;
      align-items: flex-end;
      padding-bottom: 0.5rem;
    }
  }

  /* ── Cover Image ── */
  .gallery-cover {
    margin-bottom: 2rem;
    overflow: hidden;
    border-radius: 1rem;
  }

  .gallery-cover-img {
    max-height: 60vh;
    width: 100%;
    object-fit: cover;
  }

  /* ── Image Grid ── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0 0;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.75rem;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--gallery-foreground) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    padding: 0;
  }

  .gallery-item:hover {
    border-color: color-mix(in srgb, var(--gallery-accent) 40%, transparent);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--gallery-accent) 12%, transparent);
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.05);
  }

  .gallery-item-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    background: linear-gradient(
      to top,
      color-mix(in srgb, black 60%, transparent) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }

  .gallery-item:hover .gallery-item-overlay,
  .gallery-item:focus-visible .gallery-item-overlay {
    opacity: 1;
  }

  .gallery-item-alt {
    font-size: 0.75rem;
    color: white;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  /* ── Empty State ── */
  .gallery-empty {
    margin-top: 3rem;
    text-align: center;
    color: color-mix(in srgb, var(--gallery-foreground) 50%, transparent);
    font-style: italic;
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: var(--gallery-background);
    border: none;
    z-index: 100;
    color: var(--gallery-foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--gallery-foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 1.5rem;
    min-height: 0;
    gap: 1.5rem;
  }

  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.25rem;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    will-change: transform;
    transform: translateZ(0);
  }

  .lightbox-caption {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--gallery-foreground) 80%, transparent);
    text-align: center;
    max-width: 50ch;
    line-height: 1.5;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    background: color-mix(in srgb, var(--gallery-foreground) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--gallery-border) 15%, transparent);
    color: color-mix(in srgb, var(--gallery-foreground) 70%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0.75rem;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--gallery-background) 50%, transparent);
  }

  .lightbox-btn:hover {
    background: color-mix(in srgb, var(--gallery-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--gallery-accent) 40%, transparent);
    color: var(--gallery-accent);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px -4px color-mix(in srgb, var(--gallery-accent) 25%, transparent);
  }

  .lightbox-nav {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .lightbox-main {
      padding: 0 0 1rem 0;
      gap: 0;
      position: relative;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      padding: 1rem 0.5rem;
    }
    .lightbox-nav:hover {
      transform: translateY(-50%) scale(1.1);
    }
    #lightbox-prev {
      left: 0;
    }
    #lightbox-next {
      right: 0;
    }
    .lightbox-image {
      max-height: calc(100dvh - 8rem);
    }
  }
</style>
