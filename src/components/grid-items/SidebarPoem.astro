---
import { poems, getPoem } from "@/data/poetry/poems.ts";
import { l as labelPoem } from "@/data/poetry/labels.ts";

interface Props {
  currentSlug?: string;
  poemSlug?: string;
}

const {
  currentSlug, poemSlug,
} = Astro.props;

const poem = poemSlug ? getPoem(poemSlug) : poems[0];
---

{
  poemSlug && (<nav>
    <a href="/poems" class="home-link" title="Về Kho thơ">{labelPoem("nav.goPoemStorage")}</a>

    <a
      href={`/poems/${poem.slug}`}
      class:list={["poem-title", { active: currentSlug === poem.slug }]}
    >
      {poem.title}
    </a>

    {poem.parts.map((part) => (
      <div class="part">
        <span class="part-label">{part.title}</span>
        <ul>
          {part.stanzas.map((s) => (
            <li>
              <a
                href={`/poems/${poem.slug}/${s.slug}`}
                class:list={[{ active: currentSlug === s.slug }]}
              >
                <span class="dot" />
                <span class="ch-title">{s.number}. {s.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>)
}

<style>
  nav {
    font-size: 0.8rem;
  }

  .home-link {
    display: block;
    padding: 0.4rem 1.25rem;
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    margin-right: 1rem !important;
  }

  .home-link:hover {
    color: var(--text);
  }

  .poem-title, .collection-title {
    display: block;
    padding: 0.4rem 1.25rem;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .poem-title.active, .collection-title.active {
    color: var(--accent);
  }

  .part {
    margin-bottom: 1rem;
  }

  .part-label {
    display: block;
    padding: 0 1.25rem;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  ul {
    list-style: none;
  }

  li a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 1.25rem;
    color: var(--text-muted);
    transition: color 0.1s, background 0.1s;
  }

  li a:hover {
    color: var(--text);
    background: var(--border);
  }

  li a.active {
    color: var(--accent);
    background: var(--accent-bg);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--text-muted);
  }

  .ch-title, .k-title {
    line-height: 1.3;
  }
</style>
