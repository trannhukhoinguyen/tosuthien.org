---
const {
    iconTop,
    iconBottom,
    explainTitle
} = Astro.props;
---

<fieldset style="margin-block: 8px">
    <legend><h4>{ iconTop } KINH</h4></legend>
    <div style="color: var(--color-accent-darkorange)">
        <slot />
    </div>
</fieldset>
{
  explainTitle ? <h5>{ iconBottom } { explainTitle }</h5> : null
}


