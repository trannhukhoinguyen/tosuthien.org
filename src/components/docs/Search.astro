---
---

<div
    x-data="{
        open: false,
        focused: false,
        query: '',
        loading: false,
        results: [],
        popular: [],
        fallbackIndex: [],
        fallbackLoadState: 'idle',
        fallbackPromise: null,
        pagefindStatus: 'unknown',
        searchRequestId: 0,
        fallbackReported: false,
        init() {
            this.ensureFallbackData();
        },
        async ensureFallbackData() {
            if (this.fallbackLoadState === 'ready') return true;
            if (this.fallbackLoadState === 'loading' && this.fallbackPromise) {
                await this.fallbackPromise;
                return this.fallbackLoadState === 'ready';
            }

            this.fallbackLoadState = 'loading';
            this.fallbackPromise = fetch('/search-index.json')
                .then((res) => {
                    if (!res.ok) {
                        throw new Error(`Fallback index request failed (${res.status})`);
                    }
                    return res.json();
                })
                .then((payload) => {
                    this.fallbackIndex = Array.isArray(payload?.docs) ? payload.docs : [];
                    this.popular = Array.isArray(payload?.popular) ? payload.popular : [];
                    this.fallbackLoadState = 'ready';
                })
                .catch((error) => {
                    console.error('Fallback search index failed to load:', error);
                    this.fallbackLoadState = 'error';
                    this.fallbackIndex = [];
                    this.popular = [];
                });

            await this.fallbackPromise;
            return this.fallbackLoadState === 'ready';
        },
        scoreFallbackItem(item, q, tokens) {
            const title = (item.title || '').toLowerCase();
            const excerpt = (item.excerpt || '').toLowerCase();
            const category = (item.category || '').toLowerCase();

            let score = 0;
            if (title === q) score += 300;
            if (title.startsWith(q)) score += 180;
            if (title.includes(q)) score += 120;
            if (category.includes(q)) score += 50;
            if (excerpt.includes(q)) score += 35;

            for (const token of tokens) {
                if (title.startsWith(token)) score += 50;
                else if (title.includes(token)) score += 30;
                if (category.includes(token)) score += 10;
                if (excerpt.includes(token)) score += 8;
            }

            return score;
        },
        fallbackSearch(term) {
            const q = term.trim().toLowerCase();
            if (!q) return [];
            const tokens = q.split(/\s+/).filter(Boolean);

            return this.fallbackIndex
                .map((item) => ({
                    item,
                    score: this.scoreFallbackItem(item, q, tokens),
                }))
                .filter((entry) => entry.score > 0)
                .sort((a, b) => {
                    if (b.score !== a.score) return b.score - a.score;
                    return a.item.title.localeCompare(b.item.title);
                })
                .slice(0, 8)
                .map(({ item }) => ({
                    url: item.url,
                    title: item.title,
                    excerptText: item.excerpt,
                }));
        },
        reportFallback(reason) {
            if (this.fallbackReported) return;
            this.fallbackReported = true;
            window.dispatchEvent(
                new CustomEvent('sgkb:search:fallback', {
                    detail: { reason },
                }),
            );
            console.info('Search fallback enabled:', reason);
        },
        async ensurePagefind() {
            if (this.pagefindStatus === 'ready') return true;
            if (this.pagefindStatus === 'unavailable') return false;
            if (typeof window.pagefind !== 'undefined') {
                this.pagefindStatus = 'ready';
                return true;
            }
            try {
                window.pagefind = await import('/pagefind/pagefind.js');
                await window.pagefind.init();
                this.pagefindStatus = 'ready';
                return true;
            } catch {
                this.pagefindStatus = 'unavailable';
                return false;
            }
        },
        async runFallbackSearch(query, reason, requestId) {
            const hasIndex = await this.ensureFallbackData();
            if (requestId !== this.searchRequestId) return;
            if (!hasIndex) {
                this.results = [];
                this.loading = false;
                return;
            }
            this.reportFallback(reason);
            this.results = this.fallbackSearch(query);
            this.loading = false;
        },
        async search() {
            const requestId = ++this.searchRequestId;
            this.open = true;

            const query = this.query.trim();
            if (!query) {
                this.results = [];
                this.loading = false;
                return;
            }

            this.loading = true;
            const pagefindReady = await this.ensurePagefind();
            if (requestId !== this.searchRequestId) return;

            if (!pagefindReady) {
                await this.runFallbackSearch(query, 'pagefind-unavailable', requestId);
                return;
            }

            try {
                const found = await window.pagefind.search(query);
                if (requestId !== this.searchRequestId) return;

                const pagefindResults = await Promise.all(
                    found.results.slice(0, 8).map((r) => r.data()),
                );
                if (requestId !== this.searchRequestId) return;

                this.results = pagefindResults.map((result) => ({
                    url: result.url,
                    title: result.meta?.title || 'Untitled',
                    excerptText: result.excerpt?.replace(/<[^>]*>/g, '') || '',
                }));
                this.loading = false;
            } catch {
                await this.runFallbackSearch(query, 'pagefind-search-error', requestId);
            }
        },
        async searchFromButton() {
            this.open = true;
            await this.search();
            this.$refs.searchInput?.focus();
        },
        async usePopular(term) {
            this.query = term;
            await this.search();
        }
    }"
    @click.outside="open = false"
    @keydown.escape="open = false"
    class="relative w-full max-w-[600px] mx-auto"
>
  <div
    class="search-box"
    :class="{ 'is-focused': focused }"
  >
    <input
      x-ref="searchInput"
      type="text"
      x-model="query"
      @focus="focused = true; open = true; ensureFallbackData()"
      @blur="focused = false"
      @click="open = true"
      @input="loading = query.trim().length > 0"
      @input.debounce.250ms="search()"
      @keydown.enter.prevent="searchFromButton()"
      placeholder="Search for articles..."
      class="search-input"
    />
    <button
      type="button"
      @click="searchFromButton()"
      class="search-button"
      aria-label="Search"
    >
        <span class="search-icon-wrapper">
            <svg
              x-show="!loading"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <span
              x-show="loading"
              class="search-spinner"
              style="display: none;"
            ></span>
        </span>
    </button>
  </div>

  <div
    x-show="open"
    x-transition
    class="search-dropdown"
    style="display:none;"
  >
    <div class="search-dropdown-header">
      <span x-text="query.trim() ? 'Search Results' : 'Popular Searches'"></span>
    </div>

    <div class="search-dropdown-body">
      <div x-show="loading" class="search-status-text">Searching...</div>

      <template x-if="!loading && !query.trim()">
        <ul class="search-list">
          <template x-for="term in popular" :key="term">
            <li>
              <button
                type="button"
                @click="usePopular(term)"
                class="search-popular-btn"
              >
                            <span class="search-popular-label">
                                <span class="search-popular-dot"></span>
                                <span x-text="term"></span>
                            </span>
              </button>
            </li>
          </template>
        </ul>
      </template>

      <template x-if="!loading && query.trim() && results.length > 0">
        <ul class="search-list">
          <template x-for="result in results" :key="result.url">
            <li>
              <a
                :href="result.url"
                class="search-result-item"
              >
                <p class="search-result-title" x-text="result.title"></p>
                <p class="search-result-excerpt" x-text="result.excerptText"></p>
              </a>
            </li>
          </template>
        </ul>
      </template>

      <div
        x-show="!loading && query.trim() && results.length === 0"
        class="search-status-text text-muted"
      >
        No results found.
      </div>
    </div>
  </div>
</div>

<style>
  /* Container tìm kiếm */
  .search-box {
    display: flex;
    align-items: center;
    background-color: #ffffff;
    border-radius: 12px;
    padding: 6px;
    transition: all 0.2s ease;
  }

  .search-box.is-focused,
  .search-box:focus-within {
    box-shadow: var(--sgkb-search-focus-shadow);
    transform: translateY(-2px);
  }

  /* Ô nhập liệu */
  .search-input {
    width: 100%;
    background-color: transparent;
    padding: 0.75rem 1.25rem;
    color: var(--sgkb-text-tertiary);
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 400;
    outline: none;
    border: none;
  }

  .search-input::placeholder {
    color: var(--sgkb-text-tertiary);
    font-weight: 400;
    opacity: 1;
  }

  /* Nút tìm kiếm */
  .search-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    background-color: var(--sgkb-primary);
    border-radius: 9999px;
    color: #ffffff;
    cursor: pointer;
    border: none;
    transition: var(--sgkb-transition-base);
  }

  .search-icon-wrapper {
    position: relative;
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
  }

  /* Icon Loading Spinner */
  .search-spinner {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #ffffff;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Dropdown Kết Quả */
  .search-dropdown {
    position: absolute;
    left: 0;
    right: 0;
    margin-top: 0.5rem;
    background-color: #ffffff;
    border-radius: 0.75rem;
    border: 1px solid var(--color-brand-gray-200, #e5e7eb);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    z-index: 50;
  }

  .search-dropdown-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-brand-gray-100, #f3f4f6);
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-brand-gray-400, #9ca3af);
    text-transform: uppercase;
  }

  .search-dropdown-body {
    max-height: 300px;
    overflow-y: auto;
  }

  .search-status-text {
    padding: 1.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-brand-gray-400, #9ca3af);
  }

  .search-status-text.text-muted {
    color: var(--color-brand-gray-500, #6b7280);
  }

  /* Danh sách kết quả & từ khóa phổ biến */
  .search-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    text-align: left;
  }

  .search-popular-btn {
    width: 100%;
    text-align: left;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    color: var(--color-brand-gray-600, #4b5563);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .search-popular-btn:hover {
    background-color: var(--color-brand-gray-50, #f9fafb);
  }

  .search-popular-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-popular-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-brand-gray-300, #d1d5db);
  }

  .search-result-item {
    display: block;
    padding: 0.75rem 1rem;
    text-decoration: none;
    text-align: left;
    transition: background-color 0.15s ease;
  }

  .search-result-item:hover {
    background-color: var(--color-brand-gray-50, #f9fafb);
  }

  .search-result-title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-gray-900, #111827);
    text-align: left;
  }

  .search-result-excerpt {
    margin: 0.25rem 0 0 0;
    font-size: 0.75rem;
    color: var(--color-brand-gray-500, #6b7280);
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
