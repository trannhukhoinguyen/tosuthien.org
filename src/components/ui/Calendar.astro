---
// 1. Import dữ liệu sự kiện từ file JSON ở Server-side
import staticEvents from '@/data/events/events.json';
---

<div id="calendar" class="calendar-container">
  <div class="calendar-header">
    <button id="btn-prev" class="btn">&lt; Tháng trước</button>
    <h3 id="calendar-title">Tháng --/----</h3>
    <button id="btn-next" class="btn">Tháng sau &gt;</button>
  </div>

  <div class="weekdays-grid">
    <div>T2</div><div>T3</div><div>T4</div><div>T5</div><div>T6</div><div>T7</div><div>CN</div>
  </div>

  <div id="calendar-grid" class="calendar-grid"></div>

  <div id="event-modal" class="event-modal hidden">
    <h4 id="modal-date"></h4>
    <p id="modal-lunar"></p>
    <ul id="modal-events-list"></ul>
  </div>
</div>

<script define:vars={{ staticEvents }}>
  const eventsData = staticEvents || [];

  // =========================================================================
  // THUẬT TOÁN TÍNH ÂM LỊCH VIỆT NAM CHUẨN (UTC+7) - HỒ NGỌC ĐỨC
  // =========================================================================
  function getLunarDate(dd, mm, yyyy) {
    function julianDay(d, m, y) {
      let a = Math.floor((14 - m) / 12);
      let y_ = y + 4800 - a;
      let m_ = m + 12 * a - 3;
      return d + Math.floor((153 * m_ + 2) / 5) + 365 * y_ + Math.floor(y_ / 4) - Math.floor(y_ / 100) + Math.floor(y_ / 400) - 32045;
    }

    function getNewMoonDay(k, timeZone = 7.0) {
      let T = k / 1236.85;
      let T2 = T * T;
      let T3 = T2 * T;
      let dr = Math.PI / 180.0;
      let Jd1 = 2451549.59201 + 29.530588853 * k + 0.0001337 * T2 - 0.00000015 * T3;
      let M = 2.5534 + 29.10535669 * k - 0.0000218 * T2 - 0.00000011 * T3;
      let Mpr = 201.5643 + 385.81693528 * k + 0.0107438 * T2 + 0.00001239 * T3;
      let F = 160.7108 + 390.67050274 * k - 0.0016341 * T2 - 0.00000227 * T3;
      let C = (-0.40720 * Math.sin(Mpr * dr) + 0.17241 * Math.sin(M * dr) +
        0.01608 * Math.sin(2 * Mpr * dr) + 0.01039 * Math.sin(2 * F * dr) +
        0.00739 * Math.sin((Mpr - M) * dr) - 0.00514 * Math.sin((Mpr + M) * dr) +
        0.00208 * Math.sin(2 * M * dr) - 0.00111 * Math.sin((Mpr - 2 * F) * dr) -
        0.00057 * Math.sin((Mpr + 2 * F) * dr) + 0.00056 * Math.sin((2 * Mpr + M) * dr) -
        0.00042 * Math.sin(2 * F * dr) + 0.00042 * Math.sin((Mpr + 2 * M) * dr));
      let JdNew = Jd1 + C;
      return Math.floor(JdNew + 0.5 + timeZone / 24.0);
    }

    function getSunLongitude(jdn, timeZone = 7.0) {
      let T = (jdn - 2451545.0 - timeZone / 24.0) / 36525.0;
      let T2 = T * T;
      let dr = Math.PI / 180.0;
      let L0 = 280.46645 + 36000.76983 * T + 0.0003032 * T2;
      let M = 357.52910 + 35999.05030 * T - 0.0001559 * T2 - 0.00000048 * T * T2;
      let C = (1.914600 - 0.004817 * T - 0.000014 * T2) * Math.sin(M * dr) +
        (0.019993 - 0.000101 * T) * Math.sin(2 * M * dr) +
        0.000290 * Math.sin(3 * M * dr);
      let DL = L0 + C;
      DL = DL % 360;
      if (DL < 0) DL += 360;
      return Math.floor(DL / 30.0);
    }

    function getLunarMonth11(yy, timeZone = 7.0) {
      let off = julianDay(31, 12, yy) - 2451545;
      let k = Math.floor(off / 29.5305888);
      let nm = getNewMoonDay(k, timeZone);
      let sunLong = getSunLongitude(nm, timeZone);
      if (sunLong >= 9) {
        nm = getNewMoonDay(k - 1, timeZone);
      }
      return nm;
    }

    let timeZone = 7.0;
    let dayNumber = julianDay(dd, mm, yyyy);
    let k = Math.floor((dayNumber - 2451545) / 29.5305888);
    let monthStart = getNewMoonDay(k, timeZone);
    if (monthStart > dayNumber) {
      monthStart = getNewMoonDay(k - 1, timeZone);
    }

    let a11 = getLunarMonth11(yyyy, timeZone);
    if (a11 >= dayNumber) {
      a11 = getLunarMonth11(yyyy - 1, timeZone);
    }

    let lunarDay = dayNumber - monthStart + 1;
    let diff = Math.floor((monthStart - a11) / 29.0);
    let lunarMonth = diff + 11;
    if (lunarMonth > 12) {
      lunarMonth -= 12;
    }
    return { day: lunarDay, month: lunarMonth };
  }

  // =========================================================================
  // LOGIC HIỂN THỊ LỊCH
  // =========================================================================
  let currentDate = new Date();

  const titleEl = document.getElementById('calendar-title');
  const gridEl = document.getElementById('calendar-grid');
  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');
  const modal = document.getElementById('event-modal');
  const modalDate = document.getElementById('modal-date');
  const modalLunar = document.getElementById('modal-lunar');
  const modalList = document.getElementById('modal-events-list');

  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    // Lấy thời gian thực tế của hôm nay
    const today = new Date();
    const realYear = today.getFullYear();
    const realMonth = today.getMonth();
    const realDay = today.getDate();

    titleEl.textContent = `THÁNG ${month + 1}, ${year}`;

    const firstDayIndex = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const startingPoint = firstDayIndex === 0 ? 6 : firstDayIndex - 1;

    gridEl.innerHTML = '';

    for (let i = 0; i < startingPoint; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'day-cell empty';
      gridEl.appendChild(emptyCell);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const monthStr = String(month + 1).padStart(2, '0');
      const dayStr = String(day).padStart(2, '0');
      const dateFormatted = `${year}-${monthStr}-${dayStr}`;

      // Kiểm tra xem ô ngày này có phải là hôm nay hay không
      const isToday = day === realDay && month === realMonth && year === realYear;

      const lunar = getLunarDate(day, month + 1, year);
      const lunarText = lunar.day === 1 ? `${lunar.day}/${lunar.month}` : `${lunar.day}`;

      const dayEvents = eventsData.filter((evt) => {
        if (evt.lunar) {
          if (evt.recurring === 'monthly' && evt.lunarDays) {
            return evt.lunarDays.includes(lunar.day);
          }
          if (evt.lunarMonth === lunar.month && evt.lunarDay === lunar.day) {
            return true;
          }
          return false;
        }
        return evt.date === dateFormatted;
      });

      const cell = document.createElement('div');
      // Gắn thêm class 'today' nếu đúng là ngày hiện tại
      cell.className = `day-cell${isToday ? ' today' : ''}`;

      cell.innerHTML = `
      <div class="day-header">
        <span class="solar-day" title="ngày Dương">${day}</span>
        <span class="lunar-day" title="ngày Âm">${lunarText}</span>
      </div>
      <div class="events-preview">
        ${dayEvents.map(evt => `<span class="badge ${evt.type}">${evt.title}</span>`).join('')}
      </div>
    `;

      cell.addEventListener('click', () => {
        document.querySelectorAll('.day-cell').forEach(c => c.classList.remove('selected'));
        cell.classList.add('selected');

        modalDate.textContent = `DƯƠNG LỊCH: ${dayStr}/${monthStr}/${year}`;
        modalLunar.textContent = `Âm lịch: Ngày ${lunar.day} tháng ${lunar.month}`;

        modalList.innerHTML = dayEvents.length
          ? dayEvents.map(e => `<li><b>[${e.type.toUpperCase()}]</b> ${e.title}</li>`).join('')
          : '<li>Không có sự kiện</li>';

        modal.classList.remove('hidden');
      });

      gridEl.appendChild(cell);
    }
  }

  btnPrev.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
    modal.classList.add('hidden');
  });

  btnNext.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
    modal.classList.add('hidden');
  });

  renderCalendar();

  // =========================================================================
  // APP BADGE PWA & ANCHOR SCROLL
  // =========================================================================
  async function updateAppBadge() {
    if (!('setAppBadge' in navigator)) return;

    const today = new Date();
    const year = today.getFullYear();
    const month = today.getMonth() + 1;
    const day = today.getDate();
    const dateFormatted = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

    const lunar = getLunarDate(day, month, year);

    const todayEvents = eventsData.filter((evt) => {
      if (evt.lunar) {
        if (evt.recurring === 'monthly' && evt.lunarDays) {
          return evt.lunarDays.includes(lunar.day);
        }
        return evt.lunarMonth === lunar.month && evt.lunarDay === lunar.day;
      }
      return evt.date === dateFormatted;
    });

    try {
      if (todayEvents.length > 0) {
        await navigator.setAppBadge(todayEvents.length);
      } else {
        await navigator.clearAppBadge();
      }
    } catch (error) {
      console.error('Lỗi khi set App Badge:', error);
    }
  }

  updateAppBadge();

  function handleAnchorScroll() {
    if (window.location.hash === '#calendar') {
      const calendarEl = document.querySelector('.calendar-container');
      calendarEl?.scrollIntoView({ behavior: 'smooth' });
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    handleAnchorScroll();
  } else {
    document.addEventListener('DOMContentLoaded', handleAnchorScroll);
  }

  document.addEventListener('astro:page-load', handleAnchorScroll);
</script>

<style is:global>
  .calendar-container { max-width: 1200px; margin: 0 auto; font-family: system-ui, sans-serif; }

  .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .calendar-header h3 { color: #22c55e; margin: 0; font-size: 1.4rem; font-weight: bold; }
  .btn { padding: 6px 14px; border: 1px solid #444; background: #fff; color: #000; border-radius: 6px; cursor: pointer; font-weight: 600; }
  .btn:hover { background: #e5e5e5; }

  .weekdays-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center; font-weight: bold; margin-bottom: 8px; color: #9ca3af; }
  .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }

  /* Style cho Ô Ngày */
  .day-cell {
    border: 1px solid #333 !important;
    border-radius: 8px !important;
    padding: 6px 8px !important;
    min-height: 55px !important;
    background-color: #121212 !important;
    cursor: pointer;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
  }

  .day-cell.empty {
    border-color: transparent !important;
    background-color: transparent !important;
    cursor: default;
  }

  .day-cell:not(.empty):hover {
    border-color: #22c55e !important;
    background-color: #1e293b !important;
  }

  .day-cell.selected {
    border-color: #ec4899 !important;
    background-color: #311220 !important;
  }

  /* Header chia 2 cột Trái/Phải */
  .day-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
  }

  /* Ngày Dương bên trái */
  .solar-day {
    font-weight: bold !important;
    font-size: 1.2rem !important;
    color: #ffffff !important;
  }

  /* Ngày Âm bên phải */
  .lunar-day {
    font-size: 0.9rem !important;
    color: #fbbf24 !important;
    font-weight: 600 !important;
    background: rgba(251, 191, 36, 0.15) !important;
    padding: 1px 5px !important;
    border-radius: 4px !important;
    font-style: italic !important;
    font-family: VNI-Thufap1,serif;
  }

  /* Danh sách badge sự kiện */
  .events-preview {
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 40px;
    overflow-y: auto;
  }

  .badge { font-size: 0.65rem; padding: 2px 4px; border-radius: 3px; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .badge.major { background-color: #d97706; }
  .badge.vegetarian { background-color: #10d92b; }
  .badge.holy { background-color: #7507f3; }
  .badge.important { background-color: #f30707; }

  /* Modal hiển thị bên dưới */
  .event-modal { margin-top: 16px; padding: 16px; border: 1px solid #333; border-radius: 8px; background: #3f3f3f; color: #fff; }
  .event-modal h4 { color: #ec4899; margin: 0 0 8px 0; font-size: 1.1rem; }
  .event-modal p { margin: 4px 0 12px 0; color: #9ca3af; font-size: 0.95rem; }
  .event-modal ul { margin: 0; padding-left: 20px; color: #e5e7eb; }
  .hidden { display: none !important; }

  /* Hiệu ứng làm nổi bật ngày hiện tại */
  .day-cell.today {
    border: 2px solid #3b82f6 !important; /* Viền xanh dương sáng */
    background-color: #1e3a8a !important; /* Nền xanh sẫm nổi bật */
  }

  /* Khi rê chuột vào ngày hiện tại */
  .day-cell.today:hover {
    background-color: #1d4ed8 !important;
  }
</style>
