---
interface Props {
    masterName?: string;
    title?: string;
    context?: string;
    sealText?: string;
}

const {
    masterName,
    title,
    context = "Sư dạy chúng",
    sealText
} = Astro.props;
---

<div class="zen-lecture-wrapper">
    <header class="zen-lecture-header">
        <div class="zen-header-main">
            {
                masterName && <h2 class="zen-master-name">{ masterName }</h2>
            }
            {
                title && <h3 class="zen-master-name">{ title }</h3>
            }
            {
                sealText && <div class="zen-seal">{ sealText }</div>
            }
        </div>
        {
            context && <p class="zen-lecture-context">{ context }</p>
        }
    </header>

    <article class="zen-lecture-body">
        <slot />
    </article>

    <div class="zen-footer-mark"></div>
</div>

<style>
    .zen-lecture-wrapper {
        font-family: var(--font-mali), "Times New Roman", serif;
        max-width: 100%;
        margin: 3rem auto;
        padding: 3rem 2.5rem;
        background-color: #faf6ee;
        border-left: 2px solid #3a352d;
        border-right: 2px solid #3a352d;
        position: relative;
        box-shadow: inset 0 0 30px rgba(212, 196, 169, 0.15);
    }

    .zen-lecture-header {
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .zen-header-main {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        width: 100%;
        position: relative;
    }

    .zen-master-name {
        font-size: 1.45rem;
        font-weight: bold;
        color: #1a1a1a;
        letter-spacing: 2px;
        margin: 0;
        text-transform: uppercase;
        line-height: 1.3;
        text-align: center;
    }

    /* Con dấu triện đỏ Chu Sa khắc chìm kiểu cổ xưa */
    .zen-seal {
        flex-shrink: 0;
        border: 2px solid #b32d2d;
        color: #b32d2d;
        font-family: var(--font-pacifico), Courier, monospace; /* Tạo cảm giác nét chữ vuông vức như đục đá */
        font-size: 0.7rem;
        font-weight: 900;
        padding: 2px;
        width: 100%;
        height: 100%;
        line-height: 1.1;
        text-align: center;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        transform: rotate(-4deg);
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: end;
        background-color: #faf6ee;

        /* Hiệu ứng mờ nhòe giả mực triện trên giấy */
        opacity: 0.88;
        filter: contrast(1.2);
        border-radius: 1px;
    }

    .zen-lecture-context {
        font-size: 0.95rem;
        color: #6e665a;
        font-style: italic;
        margin-top: 0.8rem;
        margin-bottom: 0;
        text-align: center;
    }

    /* Xử lý khoảng cách và định dạng cho text từ Markdown */
    .zen-lecture-body {
        color: #2b2b2b;
    }

    .zen-lecture-body :global(p) {
        font-size: 1.1rem;
        line-height: 1.8;
        text-align: justify;
        text-indent: 2rem;
        margin: 0 0 1.2rem 0;
        letter-spacing: 0.2px;

        font-weight: 600;
    }

    /* Tạo điểm nhấn ký tự đầu tiên của bài khai thị */
    .zen-lecture-body :global(p:first-of-type::first-letter) {
        font-size: 1.5rem;
        font-weight: bold;
        color: #b32d2d; /* Màu đỏ nhẹ tâm thành */
        padding-right: 2px;
    }

    .zen-footer-mark {
        width: 6px;
        height: 6px;
        border: 1px solid #a69c8d;
        border-radius: 50%;
        margin: 2.5rem auto 0 auto;
    }
</style>
