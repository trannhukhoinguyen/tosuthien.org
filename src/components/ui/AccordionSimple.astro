---
interface Content {
  title?: string;
  description?: string;
}
interface Props {
  title?: string;
  tagLine?: string;
  description?: string;
  contents: Content[];
}

const { contents = [] } = Astro.props;
---

<div class="accordion-group">
  {
    contents?.map((content, index) => (
      <details class="accordion-item" open={index === 0}>
        <summary class="accordion-header">
          <h4 class="sample-h1">{content.title}</h4>
          <span class="chevron-icon" aria-hidden="true"></span>
        </summary>
        <div class="accordion-body">
          <div class="type-meta">
            {
              content.description?.includes(' / ')
                ? content.description?.split(' / ')?.map(line => <p>{line}</p>)
                : <p>{content.description}</p>
            }
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  /* Color var */
  :root {
    /* Tông nền & Viền */
    --bg-card: #18181b;
    --bg-card-hover: #202024;
    --border-color: rgba(255, 255, 255, 0.1);
    --border-hover: rgba(255, 255, 255, 0.25);

    /* Màu chủ đạo (Accent) */
    --primary-accent: #FFD700FF;
    --primary-accent-subtle: rgba(99, 102, 241, 0.15);
    --primary-accent-hover: #F3E287FF;

    /* Màu chữ */
    --text-heading: #ffffff;
    --text-body: #d4d4d8;
    --text-muted: #a1a1aa;
  }

  /* Base Style Accordion Group */
  .accordion-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    width: 100%;
  }

  /* Item Frame */
  .accordion-item {
    background-color: var(--bg-card, #18181b);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
  }

  .accordion-item:hover {
    border-color: var(--border-hover, rgba(255, 255, 255, 0.25));
    background-color: var(--bg-card-hover, #202024);
  }

  .accordion-item[open] {
    border-color: var(--primary-accent, #6366f1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  /* Header / Summary Button */
  .accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    gap: 1rem;
    font-weight: 600;
  }

  /* Remove default browser marker */
  .accordion-header::-webkit-details-marker,
  .accordion-header::marker {
    display: none;
  }

  /* Titles inside Header */
  .accordion-header h3,
  .accordion-header h4,
  .accordion-header .blog-post-title {
    margin: 0;
    font-size: 1.125rem;
    color: var(--text-heading, #ffffff);
    flex-grow: 1;
    line-height: 1.4;
  }

  /* Index Badge for Rules Section */
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--primary-accent-subtle, rgba(99, 102, 241, 0.15));
    color: var(--primary-accent, #6366f1);
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Custom Arrow Chevron Icon (CSS Pure Draw) */
  .chevron-icon {
    position: relative;
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--text-muted, #a1a1aa);
    border-bottom: 2px solid var(--text-muted, #a1a1aa);
    transform: rotate(45deg);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s;
    flex-shrink: 0;
    margin-right: 4px;
  }

  .accordion-item:hover .chevron-icon {
    border-color: var(--text-heading, #ffffff);
  }

  /* Chevron Rotate when Open */
  .accordion-item[open] .chevron-icon {
    transform: rotate(-135deg);
    border-color: var(--primary-accent, #6366f1);
  }

  /* Accordion Body Content */
  .accordion-body {
    padding: 0 1.5rem 1.25rem 1.5rem;
    color: var(--text-body, #d4d4d8);
    font-size: 1rem;
    line-height: 1.6;
    border-top: 1px solid transparent;
    animation: fadeIn 0.3s ease-in-out;
  }

  .accordion-item[open] .accordion-body {
    border-top-color: var(--border-color, rgba(255, 255, 255, 0.05));
    padding-top: 1rem;
  }

  /* Inner Paragraphs Formatting */
  .type-meta p {
    margin-bottom: 0.5rem;
  }
  .type-meta p:last-child {
    margin-bottom: 0;
  }

  /* Blog & Practice Content Inside Accordion Body */
  .post-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary-accent, #6366f1);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .read-more-btn:hover {
    color: var(--primary-accent-hover, #818cf8);
    transform: translateX(4px);
  }

  /* Smooth Animation */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mt-6 {
    margin-top: 1.5rem;
  }
</style>
