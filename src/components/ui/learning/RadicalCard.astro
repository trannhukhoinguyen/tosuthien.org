---
// src/components/RadicalCard.astro
export interface ComponentItem {
  part: string;
  meaning: string;
}

export interface Props {
  hanzi: string;
  pinyin: string;
  sinoVi: string;      // Đổi thành sinoVi trùng với key JSON
  meaning: string;
  components?: ComponentItem[];
  audioSrc?: string;
}

const { hanzi, pinyin, sinoVi, meaning, components = [], audioSrc } = Astro.props;
---

<div class="card-container p-6 bg-stone-50 border border-amber-900/10 rounded-2xl max-w-sm mx-auto text-center shadow-sm">
  <!-- Âm Hán Việt -->
  <h3 class="text-xl font-serif text-amber-950 tracking-wider mb-2">{sinoVi}</h3>

  <!-- Khung chữ Hán chính -->
  <div class="relative w-40 h-40 mx-auto my-4 bg-sky-400 border-2 border-sky-300 rounded-lg flex flex-col items-center justify-center text-white shadow-inner">
    <span class="text-6xl font-serif leading-none">{hanzi}</span>
    <span class="text-sm opacity-90 font-light mt-2">{pinyin}</span>
  </div>

  <!-- Cấu trúc tách bộ -->
  <div class="my-4 text-amber-900 font-serif text-lg">
    {sinoVi}
    {components.map((c, index) => (
      <span>
        <span class="text-red-700 font-bold ms-1">{c.part}</span> {c.meaning}
        {index < components.length - 1 ? ' + ' : ''}
      </span>
    ))}
  </div>

  <!-- Nút nghe phát âm thẩm thấu -->
  <button
    class="play-audio-btn px-4 py-2 bg-amber-800 hover:bg-amber-900 text-amber-50 rounded-full font-medium transition flex items-center justify-center gap-2 mx-auto"
    data-audio={audioSrc}
  >
    🔊 Phản xạ âm thanh
  </button>
</div>

<script>
  // Xử lý Audio thuần bằng Web API không cần React state
  document.querySelectorAll('.play-audio-btn').forEach(button => {
    button.addEventListener('click', () => {
      const audioUrl = button.getAttribute('data-audio');
      if (audioUrl) {
        const audio = new Audio(audioUrl);
        audio.play();
      }
    });
  });
</script>
