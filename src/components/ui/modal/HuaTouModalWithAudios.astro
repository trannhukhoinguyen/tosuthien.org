            const index = Number(wrapper.querySelector('input[name="huatou"]:checked').value);
            localStorage.setItem(HUATOU_KEY, index.toString());
            playHuatou(index);
            wrapper.remove();
        };
    }*/

    function showInitialModal() {
      const wrapper = document.createElement('div');
      // Định nghĩa các cặp style xen kẽ
      const styles = [
        { color: '#5D4037', font: 'var(--font-signika), sans-serif !important', bg: '#f9f5f0' }, // Tông nâu gỗ
        { color: '#37474F', font: `var(--font-pacifico), sans-serif !important`, bg: '#ffffff' } // Tông xám xanh
      ];

      wrapper.innerHTML = `
      <div style="position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:9999;backdrop-filter:blur(4px);">
        <div style="background:white;padding:20px;border-radius:16px;max-width:500px;width:95%;box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
          <h3 style="text-align:center; margin-bottom:15px; color:#333;">Xin chọn một câu thoại đầu</h3>
          <form id="huatou-form" style="max-height:70vh; overflow-y:auto; padding-right:5px;">
            ${huatous.map((h, i) => {
        const s = styles[i % 2]; // Xen kẽ dựa trên chỉ số i
        return `
              <label style="display:block; margin:6px 0; padding:10px; border-radius:8px; 
                            cursor:pointer; background:${s.bg}; border:1px solid #eee;
                            color:${s.color}; font-family:${s.font}; font-size:1rem; transition: 0.2s;">
                <input required type="radio" name="huatou" value="${i}" style="margin-right:10px;"> 
                ${h.text}
              </label>`;
      }).join('')}
            <button type="submit" style="margin-top:15px; width:100%; padding:12px; border-radius:8px; 
                    background:#4A7C59; color:white; border:none; cursor:pointer; font-weight:bold;">
                Bắt đầu Tham Thiền
            </button>
          </form>
        </div>
      </div>`;
      document.body.appendChild(wrapper);

      // Hiệu ứng hover nhẹ khi rê chuột vào các câu
      wrapper.querySelectorAll('label').forEach(el => {
        el.onmouseenter = () => el.style.transform = 'translateX(5px)';
        el.onmouseleave = () => el.style.transform = 'translateX(0)';
      });

      wrapper.querySelector('#huatou-form').onsubmit = e => {
        e.preventDefault();
        const index = Number(wrapper.querySelector('input[name="huatou"]:checked').value);
        localStorage.setItem(HUATOU_KEY, index.toString());
        playHuatou(index);
        wrapper.remove();
      };
    }

    function showReminderModal(index) {
        const wrapper = document.createElement('div');
        wrapper.innerHTML = `
      <div style="position:fixed;inset:0;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;z-index:9999;">
        <div style="background:white;padding:20px;border-radius:12px;max-width:450px;width:90%;">
          <h2 class="huatou-accent"><strong>${huatous[index].text}</strong></h2>
          <h3 style="text-align: center">NHỚ CHIẾU CỐ THOẠI ĐẦU</h3>
          <h4 style="text-align: center"><em>(Hỏi & Nhìn vào chỗ KHÔNG BIẾT)</em></p>
          <button id="suppress" style="width:100%;margin-top:10px">Tạm ẩn 1 giờ</button>
          <button id="close" style="width:100%;margin-top:10px;background:darkred;color:white">Đã rõ</button>
        </div>
      </div>`;
        document.body.appendChild(wrapper);

        playHuatou(index);

        wrapper.querySelector('#close').onclick = () => {
            playInitTeachings();

            wrapper.remove();
        };
        wrapper.querySelector('#suppress').onclick = () => {
            playInitTeachings();

            localStorage.setItem(HUATOU_SUPPRESS, (Date.now() + 3600000).toString());
            wrapper.remove();
        };
    }

    /* ------------------ BOOT ------------------ */
    window.addEventListener('DOMContentLoaded', () => {
        preloadAudios();

        const saved = localStorage.getItem(HUATOU_KEY);
        if (!saved) return showInitialModal();

        playHuatou(Number(saved));
        if (!shouldSuppress()) showReminderModal(Number(saved));
    });
</script>

<style>
  .huatou-item-0 { color: #2c3e50; font-family: 'serif'; background: #fdfbf7; }
  .huatou-item-1 { color: #8e44ad; font-family: 'sans-serif'; background: #f7f9fd; }
