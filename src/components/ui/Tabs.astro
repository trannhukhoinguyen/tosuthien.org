---
import PaymentQR from "./PaymentQR.astro";

const { tabs, currentSlug } = Astro.props;

const activeSlug = currentSlug || tabs[0].slug;
---

<!-- 🌿 Tabs -->
<div class="tabs">
    {tabs.map(t => (
            <a
                    href={`/offering?tab=${t.slug}`}
                    class={`tab-button ${t.slug === activeSlug ? 'active' : ''}`}
                    rel="prefetch"
            >
                {t.name}
            </a>
    ))}
</div>

<!-- 🪷 Content -->
<div class="tab-content">
    {tabs.map(t => (
            <section
                    class={`tab-panel ${t.slug === activeSlug ? 'active' : ''}`}
                    data-slug={t.slug}
            >
                <div class="content-section">
                    <PaymentQR
                            facebookPostUrl={t.facebookPostUrl}
                            placeName={t.placeName}
                            eventTile={t.eventTile}
                            bankAccountSrc={t.bankAccountSrc}
                            bankQrSrc={t.bankQrSrc}
                            bankNumber={t.bankNumber}
                            bankName={t.bankName}
                            bankHost={t.bankHost}
                            bankHostRole={t.bankHostRole}
                            announcement1={t.announcement1}
                            announcement2={t.announcement2}
                            googleMap={t.googleMap}
                            placeAddress={t.placeAddress}
                    />
                </div>

                <iframe
                        title={t.placeName}
                        style="width: 100%; height: 100vh"
                        src={t.slug === activeSlug ? t.pagodaUrl : undefined}
                        class="wordpress-frame"
                        loading="lazy"
                />
            </section>
    ))}
</div>

<style>
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    #tab-content {
        transition: opacity 0.3s ease;
    }

    #tab-content.loading {
        opacity: 0.3;
    }
</style>

<!-- 🔥 Astro island script -->
<script is:inline>
    // 🧘 scroll top khi chuyển tab
    document.addEventListener('astro:page-load', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 🚀 preload khi hover (nhanh hơn rel=prefetch)
    document.querySelectorAll('.tab-button').forEach(link => {
        link.addEventListener('mouseenter', () => {
            const url = link.href;

            const existing = document.querySelector(`link[href="${url}"]`);
            if (existing) return;

            const preload = document.createElement('link');
            preload.rel = 'prefetch';
            preload.href = url;

            document.head.appendChild(preload);
        });
    });
</script>
