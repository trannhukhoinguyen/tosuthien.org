---
interface Props {
  speaker: string;      // Tên người nói (ví dụ: "Phật", "Đại Huệ")
  role?: 'speaker1' | 'speaker2'; // Phân biệt người hỏi / người đáp
}

const { speaker, role = 'speaker1' } = Astro.props;

// Cấu hình màu sắc & vị trí theo vai trò (người hỏi hoặc người đáp)
const isPrimary = role === 'speaker1';

const bubbleStyles = isPrimary
  ? 'bg-amber-100 text-amber-950 border-amber-200 rounded-tl-none self-start mr-8 shadow-amber-900/5'
  : 'bg-emerald-100 text-emerald-950 border-emerald-200 rounded-tr-none self-end ml-8 shadow-emerald-900/5';

const badgeStyles = isPrimary
  ? 'bg-amber-700 text-amber-50'
  : 'bg-emerald-700 text-emerald-50';
---

<div class={`flex flex-col my-3 max-w-[85%] ${isPrimary ? 'items-start' : 'items-end ml-auto'}`}>
  <!-- Tên người nói dạng Badge nhỏ phía trên -->
  <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full mb-1 shadow-sm ${badgeStyles}`}>
    {speaker}
  </span>

  <!-- Đám mây bong bóng nổi bật -->
  <div class={`relative px-4 py-3 rounded-2xl border shadow-lg backdrop-blur-sm transition-all duration-200 hover:-translate-y-0.5 ${bubbleStyles}`}>
    <div class="text-base leading-relaxed space-y-2">
      <slot />
    </div>
  </div>
</div>
