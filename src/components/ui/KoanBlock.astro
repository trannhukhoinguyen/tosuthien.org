---
import '@/styles/koan.css';

const { title } = Astro.props;
---

<article class="koan">
    <h1 class="koan-title">{title}</h1>

    <div class="koan-content">
        <slot />
    </div>

    <button onclick="document.querySelector('.koan').classList.toggle('hide-tung')">
        Hiện Tụng
    </button>
</article>
