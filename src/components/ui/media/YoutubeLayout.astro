---
const { frontmatter } = Astro.props;

const videos = frontmatter?.videoIds || [];
const hasSingle = videos.length === 1;
---

<div class={`yt-wrapper ${hasSingle ? "focus-mode" : ""}`} data-yt-wrapper>
  <div class={`yt-main ${hasSingle ? "active" : ""}`} data-main>
    <iframe
        data-main-iframe
        src={hasSingle ? `https://www.youtube.com/embed/${videos[0]}?start=${
            frontmatter.videoStarts?.length
                ? frontmatter.videoStarts[0]
                : 0
        }&autoplay=0` : ""}
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
    ></iframe>
  </div>

  {!hasSingle && (
      <div class="yt-grid" data-grid>
        {videos.map((id, index) => (
            <div class="yt-item" data-id={id} data-start={frontmatter.videoStarts?.[index] || 0}>
              <div class="thumb">
                <img src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`} />
              </div>
            </div>
        ))}
      </div>
  )}
</div>

<style>
  .yt-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .yt-main {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: black;
    border-radius: 12px;
    overflow: hidden;
    display: none;
  }

  .yt-main.active {
    display: block;
  }

  .yt-main iframe {
    width: 100%;
    height: 100%;
  }

  .yt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .yt-item {
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .yt-item:hover {
    transform: scale(1.03);
  }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Focus mode */
  .yt-wrapper.focus-mode .yt-grid {
    opacity: 0.2;
  }

  .yt-wrapper.focus-mode .yt-main {
    position: sticky;
    top: 0;
    z-index: 10;
  }
</style>

<script>
  const wrapper = document.querySelector("[data-yt-wrapper]");
  const main = wrapper.querySelector("[data-main]");
  const iframe = wrapper.querySelector("[data-main-iframe]");
  const items = wrapper.querySelectorAll(".yt-item");

  items.forEach((item) => {
    item.addEventListener("click", () => {
      const id = item.dataset.id;
      const start = item.dataset.start || 0;

      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&start=${start}`;

      main.classList.add("active");
      wrapper.classList.add("focus-mode");

      main.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>
