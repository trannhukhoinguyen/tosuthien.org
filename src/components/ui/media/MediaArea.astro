---
import YouTubePlaylist from "./YouTubePlaylist.astro";
// Get the frontmatter data
const { frontmatter } = Astro.props;
---

<div class="mb-12 space-y-6">
{
    // Single video NOT YTB
        frontmatter?.videoSrc && (
      <div class="video-container">
        <iframe
          src={frontmatter.videoSrc}
          title={frontmatter.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          width="100%"
        ></iframe>
      </div>
    )
  }

    {
        // Single video
        frontmatter?.videoId && (
          <div class="video-container">
              <iframe
                src={`https://www.youtube.com/embed/${frontmatter.videoId || frontmatter.videoBackup}?start=${frontmatter.videoStart ? frontmatter.videoStart : 0}`}
                title={frontmatter.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                width="100%"
              ></iframe>
          </div>
    )
    }

 <!--  <div class="video-grid" data-video-grid>
     {
// Multiple videos
     frontmatter?.videoIds?.length &&
         frontmatter.videoIds.map((id: any, index: number) => (
             <div
                 class={`video-single-container`}
                 data-video-item
             >
               <div class="video-inner">
                 <iframe
                     src={`https://www.youtube.com/embed/${id}?start=${
                         frontmatter.videoStarts?.length
                             ? frontmatter.videoStarts[index]
                             : 0
                     }`}
                     title={`${frontmatter.title} - ${index + 1}`}
                     allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                     allowfullscreen
                 ></iframe>
               </div>
             </div>
         ))
     }
 </div>-->

<!--    {
        // Multiple videos
        frontmatter?.videoIds?.length &&
          frontmatter?.videoIds?.map((id: any, index: number) => (
            <div class="video-container">
                <iframe
                  src={`https://www.youtube.com/embed/${id}?start=${frontmatter.videoStarts?.length ? frontmatter.videoStarts[index] : 0}`}
                  title={`${frontmatter.title} - ${index + 1}`}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  width="100%"
                ></iframe>
            </div>
          ))
    }-->

    {
        // YouTube playlist
        frontmatter?.videoPlaylist && (
          <div class="video-container playlist">
              <iframe
                src={`https://www.youtube.com/embed/videoseries?list=${frontmatter.videoPlaylist}`}
                title={frontmatter.title + " playlist"}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                width="100%"
              ></iframe>
          </div>
      )
    }

    {
        // YouTube playlists
        frontmatter?.videoPlaylists?.length &&
      frontmatter?.videoPlaylists?.map((videoPlaylist: any, index: number) => (
          <div class="video-container playlist">
              <iframe
                src={`https://www.youtube.com/embed/videoseries?list=${videoPlaylist}`}
                title={`${frontmatter.title} - ${index + 1}`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                width="100%"
              ></iframe>
          </div>
      ))
    }

    {
        // YouTube playlists NEW
        frontmatter?.youtubePlaylist && (<YouTubePlaylist videos={frontmatter?.youtubePlaylist} />)
    }

    {
        // Single audio
        frontmatter?.audioUrl && (
          <div>
              <h3 class="text-xl font-bold mb-4" title="Listen">🎧</h3>
              <video width="640" height="360" controls poster="/cover.jpg">
                  <source src={frontmatter.audioUrl} type="audio/mpeg" />
                  <track src={frontmatter.vtt} kind="subtitles" srclang="en" label="Lyrics" default />
              </video>
          </div>
    )
    }

    {
        // Multiple audios
        frontmatter?.audioUrls?.length &&
          frontmatter?.audioUrls?.map((url: any, index: number) => (
            <div class="audio-block">
                {index === 0 ? <h3 class="audio-heading" title="Listen">🎧</h3> : ''}
                <h4 class="audio-subheading" title={url}>{index + 1}</h4>
                <audio controls class="audio-player">
                    <source src={url} type="audio/mpeg" />
                    Your browser does not support the audio element.
                </audio>
            </div>
          ))
    }
</div>

<style>
    /* Playlist container */
    .video-container {
        position: relative;
        aspect-ratio: 16 / 9; /* 👈 FIX */
        width: 100%;
        border-radius: 8px;
        overflow: hidden;
        margin-block: calc(var(--grid-unit) * 2);
    }

    .video-container iframe {
        width: 100%;
        height: 100%; /* 👈 FIX */
        border: 0;
        margin-block: calc(var(--grid-unit) * 1);
    }

    /* Khi trên 768px (PC)
    /* Mobile breakpoint */
    @media (min-width: 769px) {
        .video-container iframe {
            min-height: 500px;
        }
    }

    /* VIDEO GRID LIKE YTB */
    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
    }

    /* video nhỏ */
    .video-single-container {
      cursor: pointer;
    }

    /* CÁI NÀY QUYẾT ĐỊNH CÓ PHÓNG HAY KHÔNG */
    .video-single-container.active {
      grid-column: 1 / -1;
    }

    /* ép chiều cao để grid bung */
    .video-inner {
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    /* iframe fill container */
    .video-inner iframe {
      width: 100%;
      height: 100%;
      border-radius: 12px;
    }

    /* khi active thì cao hơn */
    .video-single-container.active .video-inner {
      min-height: 420px;
    }

</style>


<script>
  const grid = document.querySelector("[data-video-grid]");
  if (grid) {
    const items = grid.querySelectorAll("[data-video-item]");

    items.forEach((item) => {
      item.addEventListener("click", () => {
        items.forEach((i) => i.classList.remove("active"));
        item.classList.add("active");

        item.scrollIntoView({
          behavior: "smooth",
          block: "nearest"
        });

        const iframe = item.querySelector("iframe");
        if (iframe && !iframe.src.includes("autoplay=1")) {
          iframe.src += "&autoplay=1";
        }
      });
    });
  }
</script>
