---
// src/components/RadicalCard.astro
export interface ComponentItem {
  part: string;
  meaning: string;
}

export interface Props {
  hanzi: string;
  pinyin: string;
  sinoVi: string;
  meaning: string;
  components?: ComponentItem[];
  audioSrc?: string;
}

const { hanzi, pinyin, sinoVi, meaning, components = [], audioSrc } = Astro.props;
---

<div class="card-container">
  <h3 class="sino-vi">{sinoVi}</h3>
  <h5 class="meaning">{meaning}</h5>

  <div class="character-box audio-on-hover" data-audio={audioSrc}>
    <span class="hanzi-text">{hanzi}</span>
    <span class="pinyin-text">{pinyin}</span>
    <span class="hover-indicator">🔊</span>
  </div>


  <!-- Cấu trúc tách bộ -->
  {components.length > 0 && (
    <div class="components-list">
      {components.map((c, index) => (
        <span>
          <span class="component-part">{c.part}</span> ({c.meaning})
          {index < components.length - 1 ? ' + ' : ''}
        </span>
      ))}
    </div>
  )}
</div>

<style>
  /* --- CSS Thuần --- */
  .card-container {
    margin: 1.5rem auto;
    padding: 1.5rem;
    background-color: rgb(255, 251, 245); /* bg-amber-50/50 */
    border: 1px solid rgb(120, 53, 15, 0.15); /* border-amber-900/15 */
    border-radius: 1rem; /* rounded-2xl */
    max-width: 24rem; /* max-w-sm */
    text-align: center;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); /* shadow-sm */
    transition: box-shadow 0.2s ease;
    font-family: serif; /* Dùng font serif mặc định cho card */
  }

  .card-container:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); /* shadow-md */
  }

  .card-title, .sino-vi {
    font-family: var(--font-bungee-spice), ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.25rem; /* text-xl */
    color: rgb(0 0 0); /* text-amber-950 */
    letter-spacing: 0.05em; /* tracking-wider */
    margin-bottom: 0.25rem; /* mb-1 */
  }

  .meaning {
    font-family: var(--font-patrick-hand), ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 0.8rem; /* text-xl */
    color: rgb(4 39 115); /* text-amber-950 */
    letter-spacing: 0.05em; /* tracking-wider */
    margin-bottom: 0.2rem; /* mb-1 */
  }

  .character-box {
    position: relative;
    width: 9rem; /* w-36 */
    height: 9rem; /* h-36 */
    margin: 0.75rem auto; /* my-3 */
    background-color: rgb(14, 165, 233); /* bg-sky-500 */
    border: 2px solid rgb(56, 189, 248); /* border-sky-400 */
    border-radius: 0.75rem; /* rounded-xl */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06); /* shadow-inner */
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  /* --- Hiệu ứng CSS khi hover vào khung chữ Hán --- */
  .character-box.audio-on-hover:hover {
    background-color: rgb(2, 132, 199); /* bg-sky-600 */
    cursor: pointer;
    transform: scale(1.03); /* Phóng to nhẹ */
  }

  /* Hiển thị biểu tượng loa khi hover */
  .character-box:hover .hover-indicator {
    opacity: 1;
  }

  .hanzi-text {
    font-size: 3.75rem; /* text-6xl */
    line-height: 1; /* leading-none */
  }

  .pinyin-text {
    font-size: 1rem; /* text-base */
    opacity: 0.95;
    font-family: sans-serif; /* Dùng font sans-serif cho Pinyin */
    margin-top: 0.5rem; /* mt-2 */
    letter-spacing: 0.025em; /* tracking-wide */
  }

  .hover-indicator {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 1rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .components-list {
    margin: 0.75rem 0; /* my-3 */
    color: rgb(120, 53, 15); /* text-amber-900 */
    font-size: 1rem; /* text-base */
  }

  .component-part {
    color: rgb(185, 28, 28); /* text-red-700 */
    font-weight: bold;
  }

  .play-audio-btn {
    margin-top: 0.5rem; /* mt-2 */
    padding: 0.5rem 1rem; /* px-4 py-2 */
    background-color: rgb(120, 53, 15); /* bg-amber-800 */
    color: white;
    border: none;
    border-radius: 9999px; /* rounded-full */
    font-size: 0.875rem; /* text-sm */
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .play-audio-btn:hover {
    background-color: rgb(70, 31, 1); /* bg-amber-900 */
  }
</style>

<script>
  // Chuyển logic Audio vào component
  let currentAudio = null;

  function playAudio(audioUrl) {
    if (!audioUrl) return;

    // Dừng âm thanh đang phát (nếu có) trước khi phát cái mới
    if (currentAudio) {
      currentAudio.pause();
      currentAudio.currentTime = 0;
    }

    currentAudio = new Audio(audioUrl);
    currentAudio.play().catch(e => console.error("Error playing audio:", e));
  }

  // 1. Xử lý sự kiện click vào nút (giữ nguyên chức năng cũ)
  const playButtons = document.querySelectorAll('.play-audio-btn');
  playButtons.forEach(button => {
    button.addEventListener('click', (event) => {
      event.preventDefault(); // Ngăn chặn hành vi mặc định
      const audioUrl = button.getAttribute('data-audio');
      playAudio(audioUrl);
    });
  });

  // 2. Xử lý sự kiện hover vào khung chữ Hán (.character-box)
  const hoverAudioBoxes = document.querySelectorAll('.audio-on-hover');
  hoverAudioBoxes.forEach(box => {
    // Sử dụng sự kiện 'mouseover' để phát khi chuột vừa di chuyển vào
    box.addEventListener('mouseover', () => {
      const audioUrl = box.getAttribute('data-audio');
      // Thêm một độ trễ nhỏ để tránh phát âm thanh liên tục khi di chuyển chuột qua lại
      // Nếu bạn muốn nó phát ngay lập tức, bỏ setTimeout
      playAudio(audioUrl);
    });

    // Thêm sự kiện 'mouseleave' nếu bạn muốn dừng âm thanh khi chuột rời đi
    // box.addEventListener('mouseleave', () => {
    //   if (currentAudio) {
    //     currentAudio.pause();
    //     currentAudio.currentTime = 0;
    //   }
    // });
  });
</script>
