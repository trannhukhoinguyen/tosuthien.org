---
interface EventItem {
    id: number;
    title: string;
    desc: string;
}

const {
    wheelName = "", // multi-wheel
    centerContent = "2026", // string | image url
    items = []
} = Astro.props;

const count = items.length;
const angleStep = 360 / count;

const alt = "tosuthien.org";
---

<div class="roulette-wrapper">
    <div class="wheel" id="wheel">
        <div class="center">
            {typeof centerContent === "string" && (centerContent.startsWith("http")|| centerContent.startsWith("/images/")) ? (
                    <img src={centerContent} alt={alt} />
            ) : (
                    <span>{centerContent}</span>
            )}
        </div>

        {items.map((item, i) => (
                <button
                        class="dot"
                        data-index={i}
                        style={{
                            "--i": i,
                            "--angle": `${angleStep}deg`
                        } as any}
                >
                    {String(i + 1).padStart(2, "0")}
                </button>
        ))}
    </div>

    <div class="panel">
        {items.map((item, i) => (
                <div class="event" data-index={i}>
                    <h3 class="event-title">{item.title}</h3>
                    <p class="event-description">{item.description}</p>
                </div>
        ))}
    </div>
</div>

<div id="popup" class="popup hidden">
    <div class="popup-content">
        <button class="close">×</button>
        <div id="popup-body"></div>
    </div>
</div>

<style>
    .roulette-wrapper {
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* ===== WHEEL ===== */
    .wheel {
        position: relative;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        background: #f3f3f3;
        transition: transform 0.2s linear;
        touch-action: none;
    }

    /* ===== CENTER ===== */
    .center {
        position: absolute;
        inset: 50%;
        transform: translate(-50%, -50%);
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: red;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .center img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .center span {
        color: white;
        font-size: 32px;
        font-weight: bold;
    }

    /* ===== DOT (FIX PERFECT CIRCLE) ===== */
    .dot {
        position: absolute;
        top: 50%;
        left: 50%;

        transform:
                rotate(calc(var(--i) * var(--angle)))
                translate(140px)
                rotate(calc(var(--i) * -1 * var(--angle)));

        transform-origin: center;

        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: white;
        cursor: pointer;
        font-weight: bold;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dot.active {
        background: red;
        color: white;
    }

    /* ===== PANEL ===== */
    .panel {
        width: 280px;
        position: relative;
    }

    .event {
        display: none;
        position: absolute;
        inset: 0;

        .event-title {
            display: none;
        }
        .event-description {
            display: none;
        }
    }

    .event.active {
        display: block;

        .event-title {
            color: var(--color-accent-gold);
        }
        .event-description {
            color: var(--color-accent-gold);
        }
    }

    /* ===== POPUP ===== */
    .popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .popup.hidden {
        display: none;
    }

    .popup-content {
        background: white;
        padding: 20px;
        width: 90%;
        max-width: 400px;
        border-radius: 12px;
    }

    @media (max-width: 768px) {
        .panel {
            display: none;
        }
    }
</style>

<script>
    const wheel = document.getElementById(`wheel${wheelName}`);
    const dots = document.querySelectorAll(".dot");
    const events = document.querySelectorAll(".event");

    const count = dots.length;
    const step = 360 / count;

    let currentRotation = 0;
    let velocity = 0;
    let lastAngle = 0;
    let isDragging = false;
    let isClicking = false;

    /* ===== UTIL ===== */
    function getAngle(x, y) {
        const rect = wheel.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        return Math.atan2(y - cy, x - cx) * (180 / Math.PI);
    }

    function normalize(a) {
        return (a + 360) % 360;
    }

    /* ===== ACTIVE ===== */
    function setActive() {
        let deg = normalize(-currentRotation);
        let index = Math.round(deg / step) % count;

        dots.forEach((d, i) => d.classList.toggle("active", i === index));
        events.forEach((e, i) => e.classList.toggle("active", i === index));
    }

    /* ===== APPLY ===== */
    function applyRotation() {
        wheel.style.transform = `rotate(${currentRotation}deg)`;
        setActive();
    }

    /* ===== DRAG ===== */
    wheel.addEventListener("touchstart", (e) => {
        isDragging = true;
        isClicking = false;
        velocity = 0;

        const t = e.touches[0];
        lastAngle = getAngle(t.clientX, t.clientY);
    });

    wheel.addEventListener("touchmove", (e) => {
        if (!isDragging) return;

        const t = e.touches[0];
        const angle = getAngle(t.clientX, t.clientY);

        let delta = angle - lastAngle;

        // clamp tránh quá nhanh
        delta = Math.max(-10, Math.min(10, delta));

        currentRotation += delta;
        velocity = delta;

        lastAngle = angle;

        applyRotation();
    });

    wheel.addEventListener("touchend", () => {
        isDragging = false;

        if (!isClicking) inertia();
    });

    /* ===== INERTIA ===== */
    function inertia() {
        if (Math.abs(velocity) < 0.2) {
            snap();
            return;
        }

        currentRotation += velocity;
        velocity *= 0.92;

        applyRotation();
        requestAnimationFrame(inertia);
    }

    /* ===== SNAP ===== */
    function snap() {
        let deg = normalize(-currentRotation);
        let index = Math.round(deg / step);

        const target = -index * step;

        animateTo(target);
    }

    /* ===== SMOOTH ===== */
    function animateTo(target) {
        const diff = target - currentRotation;

        if (Math.abs(diff) < 0.5) {
            currentRotation = target;
            applyRotation();
            return;
        }

        currentRotation += diff * 0.2;
        applyRotation();

        requestAnimationFrame(() => animateTo(target));
    }

    /* ===== CLICK (LOCK STATE) ===== */
    dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
            isClicking = true;
            velocity = 0;

            const target = -i * step;
            animateTo(target);

            if (window.innerWidth <= 768) {
                const popup = document.getElementById("popup");
                const body = document.getElementById("popup-body");
                const event = events[i];

                body.innerHTML = event.innerHTML;
                popup.classList.remove("hidden");
            }
        });
    });

    /* ===== CLOSE POPUP ===== */
    document.querySelector(".close").onclick = () => {
        document.getElementById("popup").classList.add("hidden");
    };

    /* ===== INIT ===== */
    applyRotation();
</script>
