---
import '@fontsource/oswald/300.css';
import '@fontsource/oswald/400.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/roboto-condensed/300.css';
import '@fontsource/roboto-condensed/400.css';
import '@fontsource/roboto-condensed/700.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';

import Header from '../components/page/Header.astro';
import Sidebar from '../components/page/Sidebar.astro';
import Footer from '../components/page/Footer.astro';
import SEO from '../components/page/SEO.astro';

import BackToTop from '../components/ui/button/BackToTop.astro';
import KeisakuSlap from "../components/ui/KeisakuSlap.astro";
import HuaTouModal from "../components/ui/modal/HuaTouModal.astro";
import HuaTouModalWithAudios from "../components/ui/modal/HuaTouModalWithAudios.astro";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../config.ts';
import ScrollToBottom from "../components/ui/button/ScrollToBottom.astro";

export interface Props {
  title: string;
  meta_title?: string;
  description?: string;
  excerpt?: string;
  showSidebar?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: string;
  collection?: string;

  // 🔥 schema type
  schemaType?:
      | 'Article'
      | 'WebPage'
      | 'Person'
      | 'Place'
      | 'FAQPage'
      | 'Book'
      | 'CreativeWork'
      | 'VideoObject';

  // 👤 Person
  person?: {
    name?: string;
    description?: string;
    birthDate?: string;
    deathDate?: string;
    master?: string;
    disciples?: string[];
  };

  // 📍 Place
  place?: {
    name?: string;
    description?: string;
  };

  // 📚 Book
  book?: {
    author?: string;
    translator?: string;
  };

  // ❓ FAQ
  faqs?: {
    question: string;
    answer: string;
  }[];

  // ❓ KOAN
  koan?: {
    master?: string;
    disciple?: string;
    lineage?: string;
  };

  // 🎬 VIDEO
  video?: {
    name?: string;
    description?: string;
    uploadDate?: string;
    thumbnailUrl?: string;
    embedUrl?: string;
    contentUrl?: string;
    duration?: string; // ISO 8601 (PT5M30S)
  };

  // 📂 PDF
  pdf?: {
    name?: string;
    url?: string;
  };
}

const {
  title,
  meta_title,
  description,
  excerpt,
  showSidebar = true,
  image = '/images/backgrounds/Buddha-zen.avif',
  type,
  publishedTime,
  modifiedTime,
  canonical,
  collection = null,
  schemaType = 'Article'
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE_URL || Astro.site).toString();
const imageURL = new URL(image, SITE_URL || Astro.site).toString();
const metaDescription = description || excerpt || SITE_DESCRIPTION;

//
// 🌐 WEBSITE
//
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${SITE_URL}#website`,
  "url": SITE_URL,
  "name": SITE_TITLE,
  "description": SITE_DESCRIPTION,
  "publisher": {
    "@id": `${SITE_URL}#organization`
  }
};

//
// 🏢 ORGANIZATION
//
const orgSchema = {
  "@type": "Organization",
  "@id": `${SITE_URL}#organization`,
  "name": SITE_TITLE,
  "url": SITE_URL,
  "logo": {
    "@type": "ImageObject",
    "url": new URL('/favicon-new.ico', SITE_URL).toString()
  }
};

//
// 🔥 CONTENT SCHEMA (CORE)
//
const contentSchema = (() => {

  // 👤 PERSON
  if (schemaType === 'Person') {
    return {
      "@type": "Person",
      "@id": `${canonicalURL}#person`,
      "name": Astro.props.person?.name || title,
      "description": metaDescription,
      "url": canonicalURL,

      // 🔥 định danh riêng
      "additionalType": "https://tosuthien.org/schema/ZenMaster",

      ...(Astro.props.person?.birthDate && {
        "birthDate": Astro.props.person.birthDate
      }),

      ...(Astro.props.person?.deathDate && {
        "deathDate": Astro.props.person.deathDate
      }),

      // 🔥 truyền thừa
      ...(Astro.props.person?.master && {
        "mentor": {
          "@type": "Person",
          "name": Astro.props.person.master
        }
      }),

      ...(Astro.props.person?.disciples && {
        "knows": Astro.props.person.disciples.map(name => ({
          "@type": "Person",
          "name": name
        }))
      }),

      "knowsAbout": ["Thiền tông", "Công án", "Zen Buddhism"],


    };
  }

  // 📍 PLACE
  if (schemaType === 'Place') {
    return {
      "@type": "Place",
      "@id": `${canonicalURL}#place`,
      "name": Astro.props.place?.name || title,
      "description": metaDescription,
      "url": canonicalURL,


    };
  }

  // 📚 BOOK
  if (schemaType === 'Book') {
    return {
      "@type": "Book",
      "@id": `${canonicalURL}#book`,
      "name": meta_title || title,
      "description": metaDescription,
      ...(Astro.props.book?.author && {
        "author": {
          "@type": "Person",
          "name": Astro.props.book.author
        }
      }),
      ...(Astro.props.book?.translator && {
        "translator": {
          "@type": "Person",
          "name": Astro.props.book.translator
        }
      }),
      "url": canonicalURL,

      // 🔥 định danh riêng
      "additionalType": "https://tosuthien.org/schema/BuddhistText",


    };
  }

  // ❓ FAQ
  if (schemaType === 'FAQPage') {
    return {
      "@type": "FAQPage",
      "@id": `${canonicalURL}#faq`,
      "mainEntity": (Astro.props.faqs || []).map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      })),

      // 🔥 định danh riêng
      "additionalType": "https://tosuthien.org/schema/BuddhistText",


    };
  }

  // 🧘 CREATIVE WORK
  if (schemaType === 'CreativeWork') {
    return {
      "@type": "CreativeWork",
      "@id": `${canonicalURL}#koan`,
      "name": meta_title || title,
      "description": metaDescription,
      "url": canonicalURL,

      // 🔥 định danh riêng
      "additionalType": "https://tosuthien.org/schema/ZenKoan",

      // 🔥 Thiền sư tạo công án
      ...(Astro.props.koan?.master && {
        "author": {
          "@type": "Person",
          "name": Astro.props.koan.master
        }
      }),

      // 🔥 người hỏi / người bị hỏi
      ...(Astro.props.koan?.disciple && {
        "recipient": {
          "@type": "Person",
          "name": Astro.props.koan.disciple
        }
      }),

      // 🔥 dòng thiền
      ...(Astro.props.koan?.lineage && {
        "isPartOf": {
          "@type": "Organization",
          "name": Astro.props.koan.lineage
        }
      }),

      // 🔥 keyword cực mạnh
      "genre": "Zen Koan",
      "keywords": ["công án", "thiền tông", "zen koan"],


    };
  }

  // 📰 ARTICLE (fallback)
  if (schemaType === 'Article') {
    return {
      "@type": "Article",
      "@id": `${canonicalURL}#article`,
      "headline": meta_title || title,
      "description": metaDescription,
      "image": [imageURL],
      "datePublished": publishedTime,
      ...(modifiedTime && { dateModified: modifiedTime }),
      "author": {
        "@type": "Organization",
        "@id": `${SITE_URL}#organization`
      },
      "publisher": {
        "@id": `${SITE_URL}#organization`
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL
      },

      // 🔥 định danh riêng
      "additionalType": "https://tosuthien.org/schema/BuddhistText",


    };
  }

  // 🎬 VIDEO
  if (schemaType === 'VideoObject') {
    return {
      "@type": "VideoObject",
      "@id": `${canonicalURL}#video`,
      "name": Astro.props.video?.name || title,
      "description": Astro.props.video?.description || metaDescription,
      "thumbnailUrl": [
        Astro.props.video?.thumbnailUrl || imageURL
      ],
      ...(Astro.props.video?.uploadDate && {
        "uploadDate": Astro.props.video.uploadDate
      }),
      ...(Astro.props.video?.duration && {
        "duration": Astro.props.video.duration
      }),
      ...(Astro.props.video?.embedUrl && {
        "embedUrl": Astro.props.video.embedUrl
      }),
      ...(Astro.props.video?.contentUrl && {
        "contentUrl": Astro.props.video.contentUrl
      }),
      "publisher": {
        "@id": `${SITE_URL}#organization`
      },
      "additionalType": "https://tosuthien.org/schema/ZenTalk",


    };
  }

  // 🌐 DEFAULT
  return {
    "@type": "WebPage",
    "@id": canonicalURL,
    "name": meta_title || title,
    "description": metaDescription,
    "isPartOf": {
      "@id": `${SITE_URL}#website`
    }
  };

})();

//
// 🍞 BREADCRUMB
//
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL}#breadcrumb`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": SITE_URL
    },
    ...(collection ? [{
      "@type": "ListItem",
      "position": 2,
      "name": collection,
      "item": `${SITE_URL}/${collection.toLowerCase()}`
    }] : []),
    {
      "@type": "ListItem",
      "position": collection ? 3 : 2,
      "name": title,
      "item": canonicalURL
    }
  ]
};

//
// 🎬 VIDEO
//
const videoSchema = Astro.props.video && {
  "@type": "VideoObject",
  "@id": `${canonicalURL}#video`,
  "name": Astro.props.video.name || title,
  "thumbnailUrl": [Astro.props.video.thumbnailUrl || imageURL],
  ...(Astro.props.video.uploadDate && {
    "uploadDate": Astro.props.video.uploadDate
  }),
  ...(Astro.props.video.duration && {
    "duration": Astro.props.video.duration
  }),
  ...(Astro.props.video.embedUrl && {
    "embedUrl": Astro.props.video.embedUrl
  }),
  "publisher": {
    "@id": `${SITE_URL}#organization`
  },

  // 🔥 ontology
  "additionalType": "https://tosuthien.org/schema/ZenTalk",


};

//
// 📂 PDF
//
const pdfSchema = Astro.props.pdf && {
  "@type": "MediaObject",
  "@id": `${canonicalURL}#pdf`,
  "name": Astro.props.pdf.name || title,
  "contentUrl": Astro.props.pdf.url,
  "encodingFormat": "application/pdf",


};

if (videoSchema || pdfSchema) {
  contentSchema.hasPart = [
    ...(videoSchema ? [{ "@id": `${canonicalURL}#video` }] : []),
    ...(pdfSchema ? [{ "@id": `${canonicalURL}#pdf` }] : [])
  ];
videoSchema.isPartOf = {
  "@id": contentSchema["@id"]
};
pdfSchema.isPartOf = {
  "@id": contentSchema["@id"]
};
}

//
// 🔥 FINAL GRAPH
//
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    websiteSchema,
    orgSchema,
    contentSchema,
    breadcrumbSchema,
    ...(videoSchema ? [videoSchema] : []),
    ...(pdfSchema ? [pdfSchema] : [])
  ]
};
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon-new.ico" sizes="48x48" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon-new.ico" sizes="48x48" type="image/x-icon">

    <!--PWA manifest-->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d4af37" />
    <script> if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/pwa-sw.js') } </script>

    <script is:inline src="/theme-init.js"></script>

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

    <SEO
      title={meta_title || title}
      description={description || excerpt}
      image={image}
      type={type}
      publishedTime={publishedTime}
      canonical={canonical}
    />
  </head>
  <body>

    <div id="top"></div>

    <div class="site-wrapper">
    <Header />


    <HuaTouModalWithAudios />

    <main class="main-content" class:list={{ 'with-sidebar': showSidebar }}>
    <div class="content">
    <slot />
    </div>

    {showSidebar && (
        <aside class="sidebar">
        <Sidebar collection={collection} />
      </aside>
      )}
      </main>

      <BackToTop />
      <ScrollToBottom />
      <Footer />
      </div>

    <div id="bottom"></div>

  </body>
</html>



<style>
  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    width: 100%;
  }

  .main-content.with-sidebar {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--grid-unit) * 4);
  }

  .content {
    min-width: 0;
    padding: calc(var(--grid-unit) * 2) 0;
  }

  .sidebar {
    order: 2;
    padding-top: calc(var(--grid-unit) * 3);
  }

/* Desktop: 2 cột */
  @media (min-width: 1024px) {
    .main-content.with-sidebar {
      grid-template-columns: 3fr 1fr;
    }

    .sidebar {
      order: 2;
      padding-top: calc(var(--grid-unit) * 1);
    }
  }


    .skip-link {
    background: var(--color-background-accent);
    left: 0;
    right: 0;
    margin: auto;
    width: min-content;
      white-space: nowrap;
    padding: 0.5rem;
    position: absolute;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
      z-index: 100;
  }

    .skip-link:focus {
    transform: translateY(0%);
  }
</style>
