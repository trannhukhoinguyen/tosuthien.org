---
import Layout from "./Layout.astro";
import Sidebar from "@/components/docs/Sidebar.astro";
import TableOfContents from "@/components/docs/TableOfContents.astro";
import { config } from "@/config.ts";
import schema from "@/data/schema.astro";
import SEO from "@/components/page/SEO.astro";

interface Props {
    title: string;
    description?: string;
    category?: string;
    currentSlug?: string;
    headings?: {
        depth: number;
        slug: string;
        text: string;
    }[];
    articleData?: {
        publishedTime?: string;
        modifiedTime?: string;
        author?: string;
        tags?: string[];
        readTimeMinutes?: number;
    };
    navigationData?: {
        previous?: { title: string; href: string };
        next?: { title: string; href: string };
    };
    relatedArticles?: {
        title: string;
        description: string;
        href: string;
    }[];
}

const {
    title,
    description,
    category,
    currentSlug,
    headings = [],
    articleData,
    navigationData,
    relatedArticles = [],
} = Astro.props;

const breadcrumbItems: { label: string; href?: string }[] = [
    { label: "Home", href: "/" },
    { label: "Documentation", href: "/docs" },
];

if (category) {
    breadcrumbItems.push({
        label: category,
        href: `/docs/category/${category.toLowerCase().replace(/\s+/g, "-")}`,
    });
}

breadcrumbItems.push({ label: title });

const lastUpdatedLabel = articleData?.modifiedTime
    ? new Intl.DateTimeFormat("en-US", {
          month: "long",
          day: "numeric",
          year: "numeric",
      }).format(new Date(articleData.modifiedTime))
    : null;

const defaultImage = "/images/backgrounds/Buddha-zen.avif";
---

<Layout title={title} description={description} articleData={articleData}>
  <header class="article-header">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon-new.ico" sizes="48x48" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon-new.ico" sizes="48x48" type="image/x-icon">

    <!--PWA manifest-->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d4af37" />

    <script is:inline src="/theme-init.js"></script>

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

    <SEO
      title={title}
      description={description}
      image={defaultImage}
      type={"article"}
      publishedTime={new Date().toISOString()}
      canonical={new URL(Astro.url.pathname, config.siteUrl).href}
    />


    <div class="article-header-overlay"></div>

    <div class="container-wide header-content">
      <nav aria-label="Breadcrumb" class="breadcrumb-nav">
        <ol class="breadcrumb-list">
          {
            breadcrumbItems.map((item, index) => (
              <li class="breadcrumb-item">
                {index > 0 && <span class="breadcrumb-separator">/</span>}
                {item.href ? (
                  <a href={item.href} class="breadcrumb-link">
                    {item.label}
                  </a>
                ) : (
                  <span class="breadcrumb-current">{item.label}</span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>
      <h1 class="article-title">
        {title}
      </h1>
      <div class="article-meta">
        <div class="meta-item">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="meta-icon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20 21a8 8 0 1 0-16 0M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
            ></path>
          </svg>
          <span>{articleData?.author || config.author}</span>
        </div>
        {
          articleData?.modifiedTime && (
            <>
              <span class="meta-dot">&bull;</span>
              <div class="meta-item">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="meta-icon"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                <span>
                                    {new Date(articleData.modifiedTime).toLocaleDateString("en-US", {
                                      month: "long",
                                      day: "numeric",
                                      year: "numeric",
                                    })}
                                </span>
              </div>
            </>
          )
        }
        <span class="meta-dot">&bull;</span>
        <div class="meta-item">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="meta-icon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <span>
                        {articleData?.readTimeMinutes || 3} min read
                    </span>
        </div>
      </div>
    </div>
  </header>

  <div
    class="container-wide main-wrapper"
    x-data="{ sidebarOpen: false }"
  >
    <!-- Mobile Sidebar Backdrop -->
    <div
      x-show="sidebarOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="sidebarOpen = false"
      class="mobile-backdrop"
      style="display: none;"
    >
    </div>

    <!-- Mobile Sidebar Content -->
    <div
      x-show="sidebarOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full"
      class="mobile-sidebar"
      style="display: none;"
    >
      <div class="mobile-sidebar-header">
        <span class="mobile-sidebar-title">Navigation</span>
        <button
          type="button"
          @click="sidebarOpen = false"
          class="mobile-sidebar-close"
          aria-label="Close navigation panel"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"
          ></path></svg
          >
        </button>
      </div>
      <Sidebar currentSlug={currentSlug} />
    </div>

    <div class="layout-grid">
      <!-- Mobile Sidebar Toggle -->
      <div class="mobile-toggle-wrapper">
        <button
          type="button"
          @click="sidebarOpen = true"
          class="mobile-toggle-btn"
          aria-label="Open documentation navigation"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><rect width="18" height="18" x="3" y="3" rx="2"
          ></rect><path d="M9 3v18"></path></svg
          >
          Documentation Menu
        </button>
      </div>

      <!-- Left Sidebar -->
      <aside class="desktop-sidebar-left">
        <div class="sticky-wrapper">
          <Sidebar currentSlug={currentSlug} />
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="main-content">
        <article
          class="prose prose-lg prose-sg"
          data-pagefind-body
        >
          <slot />
        </article>

        <!-- Feedback Section -->
        <div class="article-footer">
          {
            lastUpdatedLabel && (
              <div class="last-updated">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m12 3 2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.7 6.7 19.1l1-5.8L3.5 9.2l5.9-.9L12 3Z"></path>
                </svg>
                <span>Last updated on {lastUpdatedLabel}</span>
              </div>
            )
          }

<!--          <div
            class="feedback-box"
            x-data={`{
                            slug: ${JSON.stringify(currentSlug || "")},
                            vote: null,
                            saving: false,
                            init() {
                                if (!this.slug) return;
                                try {
                                    const key = "sgkb_feedback_vote_" + this.slug;
                                    this.vote = window.localStorage.getItem(key) || null;
                                } catch {
                                    this.vote = null;
                                }
                            },
                            submit(voteValue) {
                                if (!this.slug || this.saving) return;
                                this.saving = true;
                                try {
                                    const key = "sgkb_feedback_vote_" + this.slug;
                                    window.localStorage.setItem(key, voteValue);
                                    this.vote = voteValue;
                                } catch {
                                    this.vote = voteValue;
                                } finally {
                                    this.saving = false;
                                }
                            }
                        }`}
          >
            <h4 class="feedback-title">
              Was this article helpful?
            </h4>
            <div class="feedback-actions">
              <button
                type="button"
                @click="submit('yes')"
                :disabled="saving"
                :class="vote === 'yes' ? 'is-active' : ''"
                class="vote-btn"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M7 11V20M14.1223 20H8.90909C8.40701 20 8 19.5523 8 19V11C8 10.4477 8.40701 10 8.90909 10H11.8125L12.6448 5.00971C12.8086 4.02717 13.6004 3.29688 14.5545 3.29688V3.29688C15.7475 3.29688 16.6593 4.44876 16.3857 5.67631L15.5 10H19.2727C20.2268 10 21 10.8505 21 11.9C21 12.0249 20.9889 12.1492 20.9669 12.2717L19.7444 19.0717C19.5994 19.8795 18.928 20.4545 18.1364 20.4545H14.1223Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>Yes</span>
              </button>
              <button
                type="button"
                @click="submit('no')"
                :disabled="saving"
                :class="vote === 'no' ? 'is-active' : ''"
                class="vote-btn"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M17 13V4M9.87769 4H15.0909C15.593 4 16 4.44772 16 5V13C16 13.5523 15.593 14 15.0909 14H12.1875L11.3552 18.9903C11.1914 19.9728 10.3996 20.7031 9.44545 20.7031V20.7031C8.25254 20.7031 7.34074 19.5512 7.61427 18.3237L8.5 14H4.72727C3.77317 14 3 13.1495 3 12.1C3 11.9751 3.0111 11.8508 3.03313 11.7283L4.25562 4.92833C4.40061 4.12054 5.07198 3.54545 5.86364 3.54545H9.87769Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>No</span>
              </button>
            </div>
            <p class="feedback-status">
              <span x-show="vote === null">Your response is saved on this device.</span>
              <span x-show="vote !== null" x-text="`Thanks! You selected ${vote}.`"></span>
            </p>
          </div>-->
        </div>

        {
          (navigationData?.previous || navigationData?.next) && (
            <nav
              class="pagination-nav"
              aria-label="Article Pagination"
            >
              {navigationData?.previous ? (
                <a
                  href={navigationData.previous.href}
                  class="pagination-card pagination-prev"
                >
                                    <span class="pagination-label">
                                        <span class="pagination-arrow">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                                <path d="M19 12H5M12 19L5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                            </svg>
                                        </span>
                                        Previous Article
                                    </span>
                  <p class="pagination-title">
                    {navigationData.previous.title}
                  </p>
                </a>
              ) : (
                <div class="pagination-placeholder" aria-hidden="true"></div>
              )}

              {navigationData?.next && (
                <a
                  href={navigationData.next.href}
                  class="pagination-card pagination-next"
                >
                                    <span class="pagination-label">
                                        Next Article
                                        <span class="pagination-arrow">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                                <path d="M5 12H19M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                            </svg>
                                        </span>
                                    </span>
                  <p class="pagination-title">
                    {navigationData.next.title}
                  </p>
                </a>
              )}
            </nav>
          )
        }

      </main>

      <!-- Right Sidebar (ToC) -->
      {
        headings.length > 0 && (
          <aside class="desktop-sidebar-right">
            <div class="sticky-wrapper">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )
      }
    </div>

  </div>

  {
    relatedArticles.length > 0 && (
      <section class="related-section">
        <div class="container-wide">
          <h3 class="related-title">
            Related Articles
          </h3>
          <div class="related-grid">
            {relatedArticles.map((article) => (
              <article class="related-card">
                <a href={article.href} class="related-card-link">
                  <h4 class="related-card-title">
                    {article.title}
                  </h4>
                  <p class="related-card-desc">
                    {article.description}
                  </p>
                  <span class="related-card-action">
                                        Read more
                                        <span class="related-card-arrow">
                                            &rarr;
                                        </span>
                                    </span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style is:global>
  /* ==========================================
  Header Section
  ========================================== */
  .article-header {
    background: linear-gradient(90deg, var(--sgkb-primary) 0%, var(--sgkb-primary-light) 100%);
    padding-top: 60px;
    padding-bottom: 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .article-header-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 0%, var(--sgkb-overlay-soft), transparent 55%);
  }

  .header-content {
    position: relative;
    z-index: 10;
  }

  /* Breadcrumb Navigation */
  .breadcrumb-nav {
    margin-bottom: 1.5rem;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.5rem;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    column-gap: 1rem;
  }

  .breadcrumb-separator {
    color: rgba(255, 255, 255, 0.45);
  }

  .breadcrumb-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: #ffffff;
  }

  .breadcrumb-current {
    color: #ffffff;
    font-weight: 600;
  }

  /* Title & Metadata */
  .article-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    margin-top: 0;
    margin-bottom: 1.5rem;
    line-height: 1.2;
    max-width: 64rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.75;
  }

  .meta-dot {
    color: rgba(255, 255, 255, 0.45);
  }

  /* ==========================================
     Layout & Mobile Navigation
     ========================================== */
  .main-wrapper {
    margin-top: 60px;
    margin-bottom: 6rem;
    position: relative;
    z-index: 20;
  }

  .layout-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .layout-grid {
      flex-direction: row;
      gap: 40px;
    }
  }

  /* Mobile Navigation Components */
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(4px);
    z-index: 60;
  }

  @media (min-width: 1024px) {
    .mobile-backdrop {
      display: none !important;
    }
  }

  .mobile-sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: 20rem;
    background-color: #ffffff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    z-index: 70;
    padding: 2rem;
    overflow-y: auto;
  }

  @media (min-width: 1024px) {
    .mobile-sidebar {
      display: none !important;
    }
  }

  .mobile-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .mobile-sidebar-title {
    font-size: 0.875rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-gray-400, #9ca3af);
  }

  .mobile-sidebar-close {
    padding: 0.5rem;
    margin-right: -0.5rem;
    color: var(--color-brand-gray-400, #9ca3af);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .mobile-sidebar-close:hover {
    color: var(--color-brand-gray-900, #111827);
  }

  .mobile-toggle-wrapper {
    margin-bottom: 1rem;
  }

  @media (min-width: 1024px) {
    .mobile-toggle-wrapper {
      display: none;
    }
  }

  .mobile-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background-color: #ffffff;
    border: 1px solid var(--color-brand-gray-200, #e5e7eb);
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-brand-gray-800, #1f2937);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: all 0.15s ease;
    width: 100%;
    cursor: pointer;
  }

  .mobile-toggle-btn:active {
    transform: scale(0.95);
  }

  /* Desktop Sidebars */
  .desktop-sidebar-left {
    display: none;
    width: 18rem;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .desktop-sidebar-left {
      display: block;
    }
  }

  .desktop-sidebar-right {
    display: none;
    width: 18rem;
    flex-shrink: 0;
  }

  @media (min-width: 1280px) {
    .desktop-sidebar-right {
      display: block;
    }
  }

  .sticky-wrapper {
    position: sticky;
    top: 6rem;
  }

  /* ==========================================
     Main Content Area
     ========================================== */
  .main-content {
    flex-grow: 1;
    min-width: 0;
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: var(--sgkb-shadow-xs-soft);
    border: 1px solid var(--color-brand-gray-200, #e5e7eb);
  }

  @media (min-width: 768px) {
    .main-content {
      padding: 2.5rem;
    }
  }

  .prose-sg {
    max-width: none;
  }

  /* Footer & Feedback */
  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-brand-gray-200, #e5e7eb);
  }

  .last-updated {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-brand-gray-500, #6b7280);
  }

  .feedback-box {
    margin-top: 2.5rem;
    border-radius: 1rem;
    background-color: var(--color-brand-gray-100, #f3f4f6);
    padding: 2.25rem 1.5rem;
    text-align: center;
  }

  .feedback-title {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-brand-gray-900, #111827);
    margin: 0 0 1.25rem 0;
  }

  .feedback-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .vote-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 122px;
    height: 52px;
    padding: 0 1.25rem;
    font-size: 16px;
    line-height: 1;
    font-weight: 500;
    border-radius: 0.75rem;
    border: 1px solid var(--color-brand-gray-300, #d1d5db);
    background-color: #ffffff;
    color: var(--color-brand-gray-700, #374151);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .vote-btn:hover:not(:disabled) {
    border-color: var(--sgkb-primary, #0066cc);
    color: var(--sgkb-primary, #0066cc);
  }

  .vote-btn.is-active {
    border-color: var(--sgkb-primary, #0066cc);
    color: var(--sgkb-primary, #0066cc);
    background-color: rgba(var(--sgkb-primary-rgb, 0, 102, 204), 0.1);
  }

  .vote-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .feedback-status {
    margin: 1rem 0 0 0;
    font-size: 13px;
    color: var(--color-brand-gray-500, #6b7280);
  }

  /* Pagination Navigation */
  .pagination-nav {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-brand-gray-200, #e5e7eb);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .pagination-nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  .pagination-card {
    display: block;
    border: 1px solid var(--color-brand-gray-200, #e5e7eb);
