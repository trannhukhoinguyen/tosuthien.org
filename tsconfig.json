{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "src/types", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["astro/client", "@types/alpinejs"],
    "baseUrl": ".",
    "paths": {
      "@/assets/*": ["src/assets/*"],
      "@/components/*": ["src/components/*"],
      "@/content/*": ["src/content/*"],
      "@/config/*": ["src/config/*"],
      "@/data/*": ["src/data/*"],
      "@/images/*": ["public/images/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/libs/*": ["src/libs/*"],
      "@/styles/*": ["src/styles/*"],
      "@/types/*": ["src/types/*"],
      "@/utils/*": ["src/utils/*"],
      "@/scripts/*": ["src/scripts/*"],
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
