{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src",
    "src/types",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "astro/client",
      "@types/alpinejs"
    ],
    "baseUrl": ".",

    "paths": {
      "~/*": ["public/*"],
      "@/*": ["src/*"]
    },

    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
}
